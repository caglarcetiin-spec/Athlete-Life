  "components": {
    "schemas": {
      "AccountPatch": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "name"
        ],
        "title": "AccountPatch"
      },
      "Command": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "title": "Entity Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "command_type": {
            "type": "string",
            "maxLength": 80,
            "title": "Command Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "entity_id",
          "expected_version",
          "command_type",
          "payload"
        ],
        "title": "Command"
      },
      "CommandResult": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "cursor": {
            "type": "integer",
            "title": "Cursor"
          },
          "entity": {
            "additionalProperties": true,
            "type": "object",
            "title": "Entity"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/EntityChange"
            },
            "type": "array",
            "title": "Changes"
          },
          "committed_at": {
            "type": "string",
            "title": "Committed At"
          }
        },
        "additionalProperties": false,
