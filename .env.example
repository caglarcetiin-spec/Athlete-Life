# Server-only configuration. Copy to .env; start_local.py loads it automatically.
# Keep sqlite until you are ready to connect MongoDB.
STORAGE_BACKEND=sqlite
MONGODB_URI=
MONGODB_DATABASE=athlete_life
# After migrating account identities/photos with migrate_cloud_accounts.py:
ACCOUNT_STORAGE_BACKEND=sqlite
PORT=10000
# PORT is used only by the legacy launch.py server. Account edition: --port.
