            <button class="analysis-tab active" data-detail="detail-dashboard">Dashboard</button>
            <button class="analysis-tab" data-detail="detail-progression">12 Haftalık Progresyon</button>
            <button class="analysis-tab" data-detail="detail-body">Vücut Ölçümleri & Body Gelişimi</button>
            <button class="analysis-tab" data-detail="detail-volume">Kas Hacmi Analizi</button>
            <button class="analysis-tab" data-detail="detail-recovery">Recovery</button>
            <button class="analysis-tab" data-detail="detail-strength">Strength & PR</button>
            <button class="analysis-tab" data-detail="detail-running">Koşu Analizi</button>
            <button class="analysis-tab" data-detail="detail-bodymap">Body Map</button>
            <button class="analysis-tab" data-detail="detail-critical">Kritik Hareket Analizi</button>
            <button class="analysis-tab" data-detail="detail-rules">Uygulama & Gelişim Kuralları</button>
            <button class="analysis-tab" data-detail="detail-portal">Veri Portalı</button>
            <button class="analysis-tab" data-detail="detail-recommendation">Antrenman Önerisi</button>
          </div>

          <div class="analysis-content">
            <div id="detail-dashboard" class="detail-panel active">
              <div class="grid four">
                <div class="card metric"><span>Athlete Score</span><strong id="athleteScore">--</strong><small>Skill + Strength + Recovery + Endurance</small></div>
                <div class="card metric"><span>Recovery</span><strong id="detailRecoveryScore">--</strong><small>Son kayıtlar</small></div>
                <div class="card metric"><span>Training Load</span><strong id="detailTrainingLoad">--</strong><small>7 günlük</small></div>
                <div class="card metric"><span>Body Trend</span><strong id="detailBodyTrend">--</strong><small>Kilo değişimi</small></div>
              </div>
              <div class="grid two">
                <div class="card"><h3>Performans Özeti</h3><div id="detailDashboardSummary" class="summary-list"></div></div>
                <div class="card"><h3>Bu Haftanın Önceliği</h3><div id="detailPriority" class="insight-box"></div></div>
              </div>
            </div>

            <div id="detail-progression" class="detail-panel">
              <div class="card">
                <h3>12 Haftalık Progresyon</h3>
                <p class="hint">Haftalık kilo, readiness, antrenman sıklığı ve kritik hareket performansı.</p>
                <div class="table-wrap"><table id="progressionTable"><thead><tr><th>Hafta</th><th>Ort. Kilo</th><th>Readiness</th><th>Antrenman Günü</th><th>Planche</th><th>Front Lever</th><th>Weighted Pull-Up</th><th>Koşu km</th></tr></thead><tbody></tbody></table></div>
              </div>
            </div>

            <div id="detail-body" class="detail-panel">
              <div class="grid two">
                <div class="card">
                  <h3>Vücut Ölçümleri</h3>
                  <div class="form-grid">
                    <label>Tarih <input id="bodyDate" type="date"></label>
                    <label>Kilo kg <input id="bodyWeight" type="number" step="0.1"></label>
                    <label>Omuz cm <input id="bodyShoulders" type="number" step="0.1"></label>
                    <label>Göğüs cm <input id="bodyChest" type="number" step="0.1"></label>
                    <label>Bel cm <input id="bodyWaist" type="number" step="0.1"></label>
                    <label>Kalça cm <input id="bodyHips" type="number" step="0.1"></label>
                    <label>Sağ Kol cm <input id="bodyArmR" type="number" step="0.1"></label>
                    <label>Sol Kol cm <input id="bodyArmL" type="number" step="0.1"></label>
                    <label>Sağ Uyluk cm <input id="bodyThighR" type="number" step="0.1"></label>
                    <label>Sol Uyluk cm <input id="bodyThighL" type="number" step="0.1"></label>
                    <label>Sağ Baldır cm <input id="bodyCalfR" type="number" step="0.1"></label>
                    <label>Sol Baldır cm <input id="bodyCalfL" type="number" step="0.1"></label>
                  </div>
                  <button id="saveBodyBtn" class="primary" style="margin-top:12px">Ölçümü Kaydet</button>
                  <p id="measurementMdcNote" class="hint" style="margin-top:10px"></p>
                </div>
                <div class="card">
                  <h3>Body Gelişimi</h3>
                  <div id="bodyDevelopment" class="summary-list"></div>
                </div>
              </div>

              <div class="card" style="margin-top:16px">
                <div class="section-head">
                  <div><h3>Photo Progress Check-in</h3><p class="hint">Aynı ışık, kamera mesafesi ve pozla aylık görsel karşılaştırma. Fotoğraf kas ölçümü değildir; ölçümlere destek sağlar.</p></div>
                  <button id="saveProgressPhotos" class="primary" type="button">Foto Check-in Kaydet</button>
                </div>
                <div class="photo-progress-grid">
                  <label>Ön<input id="photoFront" type="file" accept="image/*"></label>
                  <label>Yan<input id="photoSide" type="file" accept="image/*"></label>
                  <label>Arka<input id="photoBack" type="file" accept="image/*"></label>
                </div>
                <div id="photoProgressStatus" class="save-status"></div>
                <div id="photoProgressGallery" class="photo-progress-gallery"></div>
              </div>
            </div>

            <div id="detail-volume" class="detail-panel">
              <div class="card">
                <h3>Kas Hacmi Analizi</h3>
                <p class="hint">Ana kas = 1.0 efektif set, ikincil kas = 0.5 efektif set mantığı.</p>
                <div id="muscleVolumeGrid" class="muscle-grid"></div>
              </div>
            </div>

            <div id="detail-recovery" class="detail-panel">
              <div class="grid four">
                <div class="card metric"><span>Ort. Uyku</span><strong id="recSleep">--</strong><small>7 gün</small></div>
                <div class="card metric"><span>Ort. Enerji</span><strong id="recEnergy">--</strong><small>7 gün</small></div>
                <div class="card metric"><span>Ort. Stres</span><strong id="recStress">--</strong><small>7 gün</small></div>
                <div class="card metric"><span>Recovery Score</span><strong id="recScore">--</strong><small>7 gün</small></div>
              </div>
              <div class="card" style="margin-top:16px"><h3>Recovery Önerisi</h3><div id="recoveryAdvice" class="insight-box"></div></div>
            </div>

            <div id="detail-strength" class="detail-panel">
              <div class="card">
                <h3>Strength & PR</h3>
                <div class="table-wrap"><table id="strengthTable"><thead><tr><th>Hareket</th><th>En İyi Yük</th><th>En İyi Set</th><th>Toplam Hacim</th><th>PR Durumu</th></tr></thead><tbody></tbody></table></div>
              </div>
            </div>

            <div id="detail-running" class="detail-panel">
              <div class="grid four">
                <div class="card metric"><span>7 Gün km</span><strong id="runKm7">--</strong><small>Toplam</small></div>
                <div class="card metric"><span>Koşu Sayısı</span><strong id="runCount">--</strong><small>7 gün</small></div>
                <div class="card metric"><span>Ort. Pace</span><strong id="runPace">--</strong><small>dk/km</small></div>
                <div class="card metric"><span>Koşu Yükü</span><strong id="runLoad">--</strong><small>Yaklaşık</small></div>
              </div>
              <div class="card" style="margin-top:16px"><h3>Koşu & Strength Uyumu</h3><div id="runAdvice" class="insight-box"></div></div>
            </div>

            <div id="detail-bodymap" class="detail-panel">
              <div class="card">
                <h3>Body Map</h3>
                <p class="hint">Son 7 günlük efektif set yüküne göre görsel kas haritası.</p>
                <div class="bodymap">
                  <div class="body-figure">
                    <div class="muscle chest" data-muscle="Göğüs">Göğüs</div>
                    <div class="muscle shoulders" data-muscle="Omuz">Omuz</div>
                    <div class="muscle arms" data-muscle="Kol">Kol</div>
                    <div class="muscle back" data-muscle="Sırt">Sırt</div>
                    <div class="muscle core" data-muscle="Core">Core</div>
                    <div class="muscle legs" data-muscle="Bacak">Bacak</div>
                  </div>
                  <div id="bodyMapLegend" class="summary-list"></div>
                </div>
              </div>
            </div>

            <div id="detail-critical" class="detail-panel">
              <div class="card">
                <h3>Kritik Hareket Analizi</h3>
                <div class="table-wrap"><table id="criticalTable"><thead><tr><th>Hareket</th><th>Güncel</th><th>Önceki</th><th>Değişim</th><th>Durum</th><th>Öneri</th></tr></thead><tbody></tbody></table></div>
              </div>
            </div>

            <div id="detail-rules" class="detail-panel">
              <div class="grid two">
                <div class="card">
                  <h3>Antrenmanı Uygulama Kuralları</h3>
                  <div class="rule-list">
                    <div>1. Statik skill hareketleri antrenmanın başında, tazeyken.</div>
                    <div>2. Teknik bozuluyorsa failure'a gitme.</div>
                    <div>3. Ana kuvvet hareketlerinde çoğu sette 1–2 RIR bırak.</div>
                    <div>4. İzolasyon/hacim setlerinde son setler 0–2 RIR olabilir.</div>
                    <div>5. Koşuların çoğu kolay/Zone 2 karakterinde kalsın.</div>
                    <div>6. 4 haftalık bloklarda 4. hafta hacmi %30–50 azalt.</div>
                  </div>
                </div>
                <div class="card">
                  <h3>Gelişim Odaklı Kurallar</h3>
                  <div class="rule-list">
                    <div>• Haftalık kilo artışını kontrollü tut.</div>
                    <div>• Bel çevresi hızlı artarken kuvvet/skill artmıyorsa kaloriyi gözden geçir.</div>
                    <div>• Weighted Pull-Up / Dip ve statik süreleri ana performans göstergesi olarak takip et.</div>
                    <div>• Recovery 3/5 altına düşerse hacmi azaltmayı düşün.</div>
                    <div>• Aynı harekette 2–3 hafta ilerleme yoksa yük, hacim veya dinlenmeyi yeniden düzenle.</div>
                  </div>
                </div>
              </div>
            </div>

            <div id="detail-portal" class="detail-panel">
              <div class="card">
                <h3>Veri Portalı</h3>
                <p class="hint">Tüm sistemin beslendiği tek merkez. Günlük veri, vardiya, beslenme ve antrenman kayıtları buradan özetlenir.</p>
                <div id="portalSummary" class="summary-list"></div>
              </div>
            </div>

            <div id="detail-recommendation" class="detail-panel">
              <div class="card">
                <h3>Bugünkü Antrenman Önerisi</h3>
                <div id="trainingRecommendation" class="insight-box"></div>
              </div>
            </div>
          </div>
        </div>
      </section>



