      <section id="character" class="page">
        <div class="card athlete-identity-hero">
          <div class="section-head">
            <div>
              <h3>Athlete Identity Engine <small class="version-chip">v6.9</small></h3>
              <p class="hint">Yeteneklerini tek puana sıkıştırmaz; her performans alanını ayrı sınıflandırır ve birleşiminden sporcu profilini çıkarır.</p>
            </div>
            <span id="athleteIdentityConfidence" class="plan-badge">Güven --</span>
          </div>
          <div class="athlete-identity-grid">
            <div class="athlete-archetype">
              <span>ATHLETE TYPE</span>
              <strong id="athleteTypeName">Veri bekleniyor</strong>
              <p id="athleteTypeExplanation">Kabiliyet verilerini girdikçe profil oluşacak.</p>
            </div>
            <div class="identity-stat"><span>Denge İndeksi</span><strong id="athleteBalanceIndex">--</strong><small>alanlar arası denge</small></div>
            <div class="identity-stat"><span>Uzmanlaşma</span><strong id="athleteSpecialization">--</strong><small>baskın alan farkı</small></div>
            <div class="identity-stat"><span>Veri Kapsamı</span><strong id="athleteDataCoverage">--</strong><small>doğrudan test sayısı</small></div>
          </div>
          <div id="athleteDomainMatrix" class="athlete-domain-matrix"></div>
          <div id="athleteIdentityInsight" class="insight-box neutral" style="margin-top:12px"></div>
        </div>

        <div class="card capability-lab-card" style="margin-top:16px">
          <div class="section-head">
            <div>
              <h3>Capability Lab</h3>
              <p class="hint">Calisthenics, Muscle-Up, Gymnastics Rings, kuvvet, koşu ve atletik testlerin yanında balance/control, work capacity, mobility ve endurance verilerini de tarihli olarak kaydet.</p>
            </div>
            <span id="capabilityRecordCount" class="plan-badge">0 kayıt</span>
          </div>

          <div class="capability-tabs">
            <button class="capability-tab active" data-cap-tab="calisthenics">Calisthenics</button>
            <button class="capability-tab" data-cap-tab="strength">Strength</button>
            <button class="capability-tab" data-cap-tab="running">Running</button>
            <button class="capability-tab" data-cap-tab="power">Power / Tests</button>
            <button class="capability-tab" data-cap-tab="balance">Balance / Control</button>
            <button class="capability-tab" data-cap-tab="work">Work Capacity</button>
            <button class="capability-tab" data-cap-tab="mobility">Mobility</button>
            <button class="capability-tab" data-cap-tab="endurance">Endurance</button>
          </div>

          <div id="capPanelCalisthenics" class="capability-panel active">
            <div class="capability-entry-grid">
              <label>Hareket<select id="capSkillSelect"></select></label>
              <label id="capSkillValueLabel">Performans<input id="capSkillValue" type="number" min="0" step="0.1"></label>
              <label id="capSkillLoadWrap" hidden>Ek yük (kg)<input id="capSkillLoad" type="number" min="0" step="0.5"></label>
              <label>Tarih<input id="capSkillDate" type="date"></label>
              <label>Not<input id="capSkillNote" type="text" placeholder="form, tempo, ROM..."></label>
              <button id="addSkillCapability" class="primary" type="button">Kaydet</button>
            </div>
            <div id="calisthenicsCapabilityList" class="capability-best-grid"></div>
          </div>

          <div id="capPanelStrength" class="capability-panel">
            <div class="capability-entry-grid">
              <label>Hareket<select id="capStrengthSelect"></select></label>
              <label>Yük (kg)<input id="capStrengthLoad" type="number" min="0" step="0.5"></label>
              <label>Tekrar<input id="capStrengthReps" type="number" min="1" step="1" value="1"></label>
              <label>Vücut ağırlığı (kg)<input id="capStrengthBW" type="number" min="0" step="0.1"></label>
              <label>Tarih<input id="capStrengthDate" type="date"></label>
              <button id="addStrengthCapability" class="primary" type="button">Kaydet</button>
            </div>
            <div id="strengthCapabilityList" class="capability-best-grid"></div>
          </div>

          <div id="capPanelRunning" class="capability-panel">
            <div class="capability-entry-grid">
              <label>Mesafe<select id="capRunSelect"></select></label>
              <label id="capCustomDistanceWrap" hidden>Mesafe (km)<input id="capRunDistance" type="number" min="0.1" step="0.01"></label>
              <label>Süre (dk)<input id="capRunMinutes" type="number" min="0.1" step="0.01"></label>
              <label>Tarih<input id="capRunDate" type="date"></label>
              <label>Not<input id="capRunNote" type="text" placeholder="parkur, nabız, yarış..."></label>
              <button id="addRunCapability" class="primary" type="button">Kaydet</button>
            </div>
            <div id="runningCapabilityList" class="capability-best-grid"></div>
          </div>

          <div id="capPanelPower" class="capability-panel">
            <div class="capability-entry-grid">
              <label>Test<select id="capPowerSelect"></select></label>
              <label>Değer<input id="capPowerValue" type="number" min="0" step="0.01"></label>
              <label id="capPowerUnit">Birim</label>
              <label>Tarih<input id="capPowerDate" type="date"></label>
              <label>Not<input id="capPowerNote" type="text"></label>
              <button id="addPowerCapability" class="primary" type="button">Kaydet</button>
            </div>
            <div id="powerCapabilityList" class="capability-best-grid"></div>
          </div>

          <div id="capPanelBalance" class="capability-panel">
            <div class="capability-entry-grid">
              <label>Test<select id="capBalanceSelect"></select></label><label>Değer<input id="capBalanceValue" type="number" min="0" step="0.01"></label><label id="capBalanceUnit">Birim</label><label>Tarih<input id="capBalanceDate" type="date"></label><label>Not<input id="capBalanceNote" type="text" placeholder="taraf, stabilite, form..."></label><button id="addBalanceCapability" class="primary" type="button">Kaydet</button>
            </div><div id="balanceCapabilityList" class="capability-best-grid"></div>
          </div>

          <div id="capPanelWork" class="capability-panel">
            <div class="capability-entry-grid">
              <label>Test<select id="capWorkSelect"></select></label><label>Değer<input id="capWorkValue" type="number" min="0" step="0.01"></label><label id="capWorkUnit">Birim</label><label>Tarih<input id="capWorkDate" type="date"></label><label>Not<input id="capWorkNote" type="text" placeholder="süre, protokol, form..."></label><button id="addWorkCapability" class="primary" type="button">Kaydet</button>
            </div><div id="workCapabilityList" class="capability-best-grid"></div>
          </div>

          <div id="capPanelMobility" class="capability-panel">
            <div class="capability-entry-grid">
              <label>Test<select id="capMobilitySelect"></select></label><label>Değer<input id="capMobilityValue" type="number" min="0" step="0.01"></label><label id="capMobilityUnit">Birim</label><label>Tarih<input id="capMobilityDate" type="date"></label><label>Not<input id="capMobilityNote" type="text" placeholder="sağ/sol, ağrı, ROM..."></label><button id="addMobilityCapability" class="primary" type="button">Kaydet</button>
            </div><div id="mobilityCapabilityList" class="capability-best-grid"></div>
          </div>

          <div id="capPanelEndurance" class="capability-panel">
            <div class="capability-entry-grid">
              <label>Test<select id="capEnduranceSelect"></select></label><label>Değer<input id="capEnduranceValue" type="number" min="0" step="0.01"></label><label id="capEnduranceUnit">Birim</label><label>Tarih<input id="capEnduranceDate" type="date"></label><label>Not<input id="capEnduranceNote" type="text" placeholder="nabız, parkur, protokol..."></label><button id="addEnduranceCapability" class="primary" type="button">Kaydet</button>
            </div><div id="enduranceCapabilityList" class="capability-best-grid"></div>
          </div>
        </div>

        <div class="grid two" style="margin-top:16px">
          <div class="card">
            <h3>Seviye Haritası</h3>
            <div id="athleteTierExplanation" class="recommendation-stack"></div>
          </div>
          <div class="card">
            <h3>Profil İçin En Değerli Sonraki Testler</h3>
            <div id="athleteNextTests" class="recommendation-stack"></div>
          </div>
        </div>

        <div class="grid two">
          <div class="card">
            <h3>ÇAĞLAR • Hybrid Athlete Character</h3>
            <p class="hint">Skorlar mevcut kayıtlardan türetilen kişisel takip göstergeleridir; eksik testlerde güven düşer.</p>
            <div class="radar-wrap">
              <svg id="athleteRadar" viewBox="0 0 420 420" role="img" aria-label="Athlete character radar chart"></svg>
            </div>
          </div>
          <div class="card">
            <h3>Karakter Analizi</h3>
            <div id="characterScores" class="summary-list"></div>
            <div id="characterInsight" class="insight-box" style="margin-top:14px"></div>
          </div>
        </div>
        
        <div class="card" style="margin-top:16px">
          <div class="section-head">
            <div>
              <h3>Karakter Veri Girişi</h3>
              <p class="hint">Performans testlerini elle gir. Sistem otomatik antrenman kayıtlarıyla birlikte Character skorunu günceller. İstersen 0–100 skoru manuel override edebilirsin.</p>
            </div>
            <button id="saveCharacterDataBtn" class="primary" type="button">Karakter Verisini Kaydet</button>
          </div>
          <div id="characterSaveStatus" class="save-status"></div>

          <div class="character-input-grid">
            <div class="character-input-group">
              <h4>Calisthenics / Skill</h4>
              <label>Full Planche max hold (sn)<input id="charPlanche" type="number" min="0" step="0.1"></label>
              <label>Front Lever max hold (sn)<input id="charFrontLever" type="number" min="0" step="0.1"></label>
              <label>Back Lever max hold (sn)<input id="charBackLever" type="number" min="0" step="0.1"></label>
              <label>Strict Muscle-Up max tekrar<input id="charMuscleUp" type="number" min="0" step="1"></label>
              <label>L-Sit max hold (sn)<input id="charLSit" type="number" min="0" step="0.1"></label>
            </div>

            <div class="character-input-group">
              <h4>Relative / Max Strength</h4>
              <label>Vücut ağırlığı (kg)<input id="charBodyweight" type="number" min="0" step="0.1"></label>
              <label>Weighted Pull-Up ek yük (kg)<input id="charWpuLoad" type="number" min="0" step="0.5"></label>
              <label>Weighted Pull-Up tekrar<input id="charWpuReps" type="number" min="0" step="1"></label>
              <label>Weighted Dip ek yük (kg)<input id="charDipLoad" type="number" min="0" step="0.5"></label>
              <label>Weighted Dip tekrar<input id="charDipReps" type="number" min="0" step="1"></label>
              <label>OHP en iyi yük (kg)<input id="charOHP" type="number" min="0" step="0.5"></label>
            </div>

            <div class="character-input-group">
              <h4>Running / Endurance</h4>
              <label>5 km süre (dk)<input id="char5k" type="number" min="0" step="0.01"></label>
              <label>En uzun koşu (km)<input id="charLongRun" type="number" min="0" step="0.1"></label>
              <label>Cooper 12 dk mesafe (m)<input id="charCooper" type="number" min="0" step="10"></label>
              <label>Haftalık koşu hacmi (km)<input id="charWeeklyKm" type="number" min="0" step="0.1"></label>
            </div>

            <div class="character-input-group">
              <h4>Power / Speed</h4>
              <label>Vertical Jump (cm)<input id="charVJump" type="number" min="0" step="0.5"></label>
              <label>Broad Jump (cm)<input id="charBroadJump" type="number" min="0" step="1"></label>
              <label>10 m sprint (sn)<input id="charSprint10" type="number" min="0" step="0.01"></label>
              <label>30 m sprint (sn)<input id="charSprint30" type="number" min="0" step="0.01"></label>
            </div>

            <div class="character-input-group">
              <h4>Endurance / Work Capacity</h4>
              <label>Max strict pull-up<input id="charMaxPullups" type="number" min="0" step="1"></label>
              <label>Max push-up<input id="charMaxPushups" type="number" min="0" step="1"></label>
              <label>Burpee 5 dk tekrar<input id="charBurpee5" type="number" min="0" step="1"></label>
              <label>Plank max (sn)<input id="charPlank" type="number" min="0" step="1"></label>
            </div>

            <div class="character-input-group">
              <h4>Mobility / Control</h4>
              <label>Shoulder mobility (0–100)<input id="charShoulderMob" type="number" min="0" max="100" step="1"></label>
              <label>Hip mobility (0–100)<input id="charHipMob" type="number" min="0" max="100" step="1"></label>
              <label>Ankle mobility (0–100)<input id="charAnkleMob" type="number" min="0" max="100" step="1"></label>
              <label>Balance / Control (0–100)<input id="charBalance" type="number" min="0" max="100" step="1"></label>
            </div>
          </div>

          <details class="manual-score-panel">
            <summary>Gelişmiş: Character skorlarını elle gir / override et</summary>
            <p class="hint">Boş bıraktığın skorlar test ve antrenman verilerinden hesaplanır. Girdiğin skor yalnızca ilgili karakter başlığını override eder.</p>
            <div id="manualCharacterScores" class="manual-score-grid"></div>
          </details>
        </div>


        <div class="grid two" style="margin-top:16px">
          <div class="card"><h3>Character Veri Güveni</h3><p class="hint">Skor ile ölçüm güveni ayrı tutulur.</p><div id="characterConfidence" class="confidence-grid"></div></div>
          <div class="card"><h3>Eksik Testler / Retest</h3><div id="testingEngine" class="recommendation-stack"></div></div>
        </div>

        <div class="card" style="margin-top:16px">
          <h3>Training DNA</h3>
          <div class="dna-grid">
            <div><strong>40%</strong><span>Calisthenics</span></div>
            <div><strong>25%</strong><span>Strength</span></div>
            <div><strong>15%</strong><span>Hypertrophy</span></div>
            <div><strong>15%</strong><span>Running</span></div>
            <div><strong>5%</strong><span>Power / Athleticism</span></div>
          </div>
        </div>
        <div class="card" style="margin-top:16px">
          <h3>Ekipman Profili</h3>
          <div class="equipment-grid">
            <span>✓ Pull-Up Bar</span><span>✓ Gymnastic Rings</span><span>✓ Parallettes</span>
            <span>✓ Weight Belt</span><span>✓ Backpack ≤50 kg</span><span>✓ Dumbbells</span>
            <span>✓ EZ Bar</span><span>✓ Outdoor Running</span><span>✗ Rack / Cable / Bench</span>
          </div>
        </div>
      </section>

      <section id="reports" class="page">
        <div class="report-tabs card">
          <button class="report-tab active" data-report="daily-report">Günlük Rapor</button>
          <button class="report-tab" data-report="weekly-report">Haftalık Rapor</button>
          <button class="report-tab" data-report="monthly-report">Aylık Rapor</button>
          <button class="report-tab" data-report="adaptive-report">Adaptive Intelligence</button>
          <button class="report-tab" data-report="muscle-report">Kas Haritası</button>
        </div>

        <div id="daily-report" class="report-panel active">
          <div class="grid four">
            <div class="card metric"><span>Günlük Verimlilik</span><strong id="dailyEfficiency">--</strong><small>10 üzerinden</small></div>
            <div class="card metric"><span>Readiness</span><strong id="dailyReadinessReport">--</strong><small>Bugün</small></div>
            <div class="card metric"><span>Nutrition</span><strong id="dailyNutritionReport">--</strong><small>Bugün</small></div>
            <div class="card metric"><span>Uyku</span><strong id="dailySleepReport">--</strong><small>Bugün</small></div>
          </div>
          <div class="grid two">
            <div class="card">
              <h3>Bugünün Özeti</h3>
              <div id="dailyReportSummary" class="summary-list"></div>
            </div>
            <div class="card">
              <h3>Bugün Ne Yapmalısın?</h3>
              <div id="dailyReportAdvice" class="insight-box"></div>
            </div>
          </div>
        </div>

        <div id="weekly-report" class="report-panel">
          <div class="grid four">
            <div class="card metric"><span>Haftalık Verimlilik</span><strong id="weeklyEfficiency10">--</strong><small>10 üzerinden</small></div>
            <div class="card metric"><span>Uyku Uyumu</span><strong id="weeklySleepScore">--</strong><small>7 gün</small></div>
            <div class="card metric"><span>Antrenman Uyumu</span><strong id="weeklyTrainingScore">--</strong><small>7 gün</small></div>
            <div class="card metric"><span>Beslenme Uyumu</span><strong id="weeklyNutritionScore2">--</strong><small>7 gün</small></div>
          </div>
          <div class="grid two">
            <div class="card">
              <h3>Haftalık Performans Raporu</h3>
              <div id="weeklyReportSummary2" class="summary-list"></div>
              <div id="weeklyAdherenceContext" class="insight-box neutral" style="margin-top:12px"></div>
            </div>
            <div class="card">
              <h3>Yeni Hafta İçin Öneriler</h3>
              <div id="nextWeekAdvice" class="recommendation-stack"></div>
            </div>
          </div>
        </div>

        <div id="monthly-report" class="report-panel">
          <div class="grid four">
            <div class="card metric"><span>Aylık Verimlilik</span><strong id="monthlyEfficiency10">--</strong><small>10 üzerinden</small></div>
            <div class="card metric"><span>Ort. Readiness</span><strong id="monthlyReadiness">--</strong><small>30 gün</small></div>
            <div class="card metric"><span>Antrenman Günü</span><strong id="monthlyTrainingDays">--</strong><small>30 gün</small></div>
            <div class="card metric"><span>Uyku Borcu</span><strong id="monthlySleepDebt">--</strong><small>30 gün</small></div>
          </div>
          <div class="grid two">
            <div class="card">
              <h3>Aylık Gelişim Özeti</h3>
              <div id="monthlyReportSummary" class="summary-list"></div>
            </div>
            <div class="card">
              <h3>Önümüzdeki Ay İçin Öneriler</h3>
              <div id="monthlyAdvice" class="recommendation-stack"></div>
            </div>
          </div>
        </div>


        <div id="adaptive-report" class="report-panel">
          <div class="grid four">
            <div class="card metric"><span>Deload İhtimali</span><strong id="adaptiveDeload">--</strong><small>trend-bazlı</small></div>
            <div class="card metric"><span>Stimulus / Fatigue</span><strong id="adaptiveSFR">--</strong><small>seçili/öncelikli kaslar</small></div>
            <div class="card metric"><span>Personal Model</span><strong id="adaptivePersonalModel">--</strong><small>öğrenme seviyesi</small></div>
            <div class="card metric"><span>Ölçüm Güveni</span><strong id="adaptiveMeasurementConfidence">--</strong><small>MDC / veri kalitesi</small></div>
          </div>
          <div class="grid two">
            <div class="card"><h3>Kişisel Response Model</h3><div id="personalResponseModel" class="recommendation-stack"></div></div>
            <div class="card"><h3>Plateau Detector</h3><div id="plateauDetector" class="recommendation-stack"></div></div>
          </div>
          <div class="grid two">
            <div class="card"><h3>Sağ / Sol Asimetri</h3><div id="asymmetryReport" class="summary-list"></div></div>
            <div class="card"><h3>Measurement Scheduler</h3><div id="measurementScheduler" class="recommendation-stack"></div></div>
          </div>
          <div class="grid two">
            <div class="card"><h3>Goal Conflict Engine</h3><div id="goalConflictEngine" class="recommendation-stack"></div></div>
            <div class="card"><h3>Testing Calendar</h3><div id="testingCalendar" class="recommendation-stack"></div></div>
          </div>
          <div class="card">
            <h3>Model Belirsizliği ve Bilim Sürümü</h3>
            <div id="adaptiveUncertainty" class="insight-box neutral"></div>
          </div>
        </div>

        <div id="muscle-report" class="report-panel">
          <div class="card">
            <div class="section-head">
              <div><h3>Muscle Growth / Stimulus Map</h3><p class="hint">Renkler antrenman uyaranını gösterir; gerçek kas büyümesi yalnızca vücut ölçümü varsa ayrı olarak raporlanır.</p></div>
              <div class="period-tabs">
                <button class="muscle-period active" data-days="1">Günlük</button>
                <button class="muscle-period" data-days="7">Haftalık</button>
                <button class="muscle-period" data-days="30">Aylık</button>
              </div>
            </div>
            <div class="card science-engine-card">
              <div class="section-head">
                <div>
                  <h4>Science Trend Engine <small class="version-chip">Evidence 2026</small></h4>
                  <p class="hint">Antrenmandan gerçek kas büyüme yüzdesi uydurmaz. Beklenen adaptasyonu ve ölçülen büyümeyi ayrı değerlendirir.</p>
                </div>
                <span id="scienceTrendConfidence" class="plan-badge">--</span>
              </div>
              <div class="grid four science-metrics">
                <div class="metric mini"><span>Beklenen Adaptasyon</span><strong id="scienceTrendScore">--</strong><small id="scienceTrendLabel">--</small></div>
                <div class="metric mini"><span>Training Stimulus</span><strong id="scienceStimulusScore">--</strong><small>28 günlük kas yükü</small></div>
                <div class="metric mini"><span>Recovery + Nutrition</span><strong id="scienceEnvironmentScore">--</strong><small>uyku/protein/enerji</small></div>
                <div class="metric mini"><span>Ölçüm Kanıtı</span><strong id="scienceMeasuredEvidence">--</strong><small>çevre / doğrudan ölçüm</small></div>
              </div>
              <div id="scienceTrendExplanation" class="insight-box neutral"></div>
              <details class="science-methodology">
                <summary>Trend nasıl hesaplanıyor?</summary>
                <div id="scienceMethodologyBody" class="science-methodology-body"></div>
              </details>
            </div>

            <div class="muscle-report-layout bodymap-pro-layout">
              <div class="bodymap-visuals">
                <div class="card real3d-card">
                  <div class="section-head">
                    <div><h4>Real 3D Anatomical Body Map <small class="version-chip">v6</small></h4><p class="hint">Yüklediğin gerçek GLB model. Sürükle: döndür · Mouse wheel/pinch: zoom · Kas yüzeyine tıkla: detay.</p></div>
                    <span id="bodyMap3DStatus" class="save-status">Model hazırlanıyor…</span>
                  </div>
                  <div class="bodymap-controls real3d-controls">
                    <div class="camera-preset-row"><button type="button" class="camera-preset active" data-camera="front">Ön</button><button type="button" class="camera-preset" data-camera="back">Arka</button><button type="button" class="camera-preset" data-camera="left">Sol</button><button type="button" class="camera-preset" data-camera="right">Sağ</button><button type="button" id="bodyMapResetCamera" class="camera-preset">Sıfırla</button></div>
                    <div class="overlay-mode-row"><button class="overlay-mode active" data-overlay="stimulus">Stimulus</button><button class="overlay-mode" data-overlay="growth">Measured Growth</button><button class="overlay-mode" data-overlay="recovery">Recovery</button><button class="overlay-mode" data-overlay="pain">Pain</button></div>
                  </div>
                  <div id="overlayModeNote" class="overlay-mode-note"></div>
                  <div class="real3d-shell"><canvas id="bodyMap3DCanvas" class="real3d-canvas"></canvas>
                    <div id="bodyMapJointMarkers" class="joint-hotspot-layer"></div>
                    <div id="bodyMap3DMarker" class="real3d-marker" hidden></div><div id="bodyMap3DTooltip" class="real3d-tooltip" hidden></div><div id="bodyMap3DLoading" class="real3d-loading"><div class="real3d-spinner"></div><strong>3D beden modeli yükleniyor</strong><span>Yaklaşık 72 MB GLB · İlk açılış biraz sürebilir.</span></div></div>
                  <div class="real3d-footer"><span id="bodyMap3DSelection">Kas yüzeyine tıklayarak bölge seç. · GLB anatomik kalibrasyon v2</span><label class="model-file-fallback" id="modelFileFallback" hidden>GLB'yi manuel seç<input id="bodyMapModelFile" type="file" accept=".glb,model/gltf-binary"></label></div>
                  <div id="bodyMapProtocolWarning" class="insight-box warn" hidden>3D model tarayıcı güvenliği nedeniyle doğrudan <b>file://</b> üzerinden yüklenemedi. Paketteki <b>START_MAC.command</b> dosyasını çalıştır veya buradan GLB dosyasını manuel seç.</div>
                </div>
              </div>
              <div class="bodymap-inspector">
                <div class="grid two compact-grid">
                  <div class="metric card"><span>Toplam Efektif Set</span><strong id="muscleTotalSets">--</strong><small>seçili dönem</small></div>
                  <div class="metric card"><span>En Çok Uyarılan</span><strong id="topStimulusMuscle">--</strong><small>kas bölgesi</small></div>
                </div>

                <div class="card bodymap-selector-card">
                  <div class="section-head">
                    <div><h4>Anatomik Kas Bölgeleri</h4><p class="hint">Aşağıdan kas bölgesi seçerek detaylı stimulus, recovery ve ölçüm bilgisini incele.</p></div>
                  </div>
                  <div id="muscleRegionGrid" class="muscle-region-grid"></div>
                </div>

                <div id="muscleDetailCard" class="card muscle-detail-card"><h3>Kas seç</h3><p class="hint">Kas bölgesi düğmelerinden birine tıkla.</p></div>

                <div class="card muscle-trend-card">
                  <div class="section-head">
                    <div>
                      <h4 id="muscleTrendTitle">Kas Adaptasyon / Ölçüm Grafiği</h4>
                      <p id="muscleTrendSubtitle" class="hint">Seçili kasın zaman içindeki değişimi.</p>
                    </div>
                  </div>
                  <div id="muscleTrendChart" class="muscle-trend-chart"></div>
                </div>

                <div id="muscleStimulusTable" class="muscle-table"></div>
              </div>
            </div>
            <div class="legend-row"><span>Az</span><i class="heat h1"></i><i class="heat h2"></i><i class="heat h3"></i><i class="heat h4"></i><i class="heat h5"></i><span>Yüksek</span></div>
          </div>
        </div>
      </section>


      <section id="records" class="page">
        <div class="card record-center-head">
          <div class="section-head">
            <div>
              <h3>Kayıt Merkezi</h3>
              <p class="hint">Yanlış girdiğin veriyi geçmişe dönük düzenle veya sil. Değişikliklerden sonra tüm analiz motorları otomatik yeniden hesaplanır.</p>
            </div>
            <button id="recordUndoBtn" class="secondary" type="button" disabled>Son İşlemi Geri Al</button>
          </div>
          <div class="record-date-controls">
            <button id="recordPrevDay" class="secondary" type="button">← Önceki</button>
            <label>Tarih <input id="recordManagerDate" type="date"></label>
            <button id="recordTodayBtn" class="secondary" type="button">Bugün</button>
            <button id="recordNextDay" class="secondary" type="button">Sonraki →</button>
          </div>
          <div id="recordManagerSummary" class="grid four compact" style="margin-top:12px"></div>
        </div>

        <div class="record-manager-grid">
          <div class="card"><div class="section-head"><div><h3>Check-in / Uyku / Recovery</h3><p class="hint">Uyku, readiness, koşu, iş yükü ve pain değerleri.</p></div></div><div id="recordDailyList"></div></div>
          <div class="card"><div class="section-head"><div><h3>Antrenman Kayıtları</h3><p class="hint">Set, tekrar/saniye, yük, RIR ve plan tarihi düzenlenebilir.</p></div></div><div id="recordTrainingList"></div></div>
          <div class="card"><div class="section-head"><div><h3>Pain / Joint Kayıtları</h3><p class="hint">Sağ/sol, şiddet, tetikleyici ve aktif/çözüldü durumu.</p></div></div><div id="recordPainList"></div></div>
          <div class="card"><div class="section-head"><div><h3>Beslenme & Su</h3><p class="hint">Öğün, porsiyon, saat ve su kaydı.</p></div></div><div id="recordNutritionList"></div></div>
          <div class="card"><div class="section-head"><div><h3>Vücut Ölçümleri</h3><p class="hint">Kilo, çevre ölçümleri ve sağ/sol ölçümler.</p></div></div><div id="recordBodyList"></div></div>
          <div class="card"><div class="section-head"><div><h3>Seans / Sosyal Kayıtlar</h3><p class="hint">Session RPE, süre, not ve sosyal plan.</p></div></div><div id="recordSessionList"></div></div>
          <div class="card"><div class="section-head"><div><h3>Capability Lab</h3><p class="hint">Yetenek, kuvvet, koşu ve atletik test geçmişi.</p></div></div><div id="recordCapabilityList"></div></div>
          <div class="card"><div class="section-head"><div><h3>Karakter Test Verileri</h3><p class="hint">Manuel athletic test değerleri de buradan temizlenebilir veya düzeltilebilir.</p></div></div><div id="recordCharacterList"></div></div>
        </div>
      </section>

      <section id="settings" class="page">
        <div class="card">
          <div class="section-head"><div><h3>Profil ve Hedefler</h3><p>Optimizer bu hedefleri kullanır.</p></div><button id="saveSettingsBtn" class="primary">Kaydet</button></div>
          <div class="form-grid">
            <label>Hedef uyku (saat) <input id="targetSleep" type="number" step="0.25" value="8"></label>
            <label>Hazırlanma süresi (dk) <input id="prepMinutes" type="number" value="45"></label>
            <label>İşe ulaşım (dk) <input id="commuteMinutes" type="number" value="35"></label>
            <label>Hedef protein (g) <input id="targetProtein" type="number" value="150"></label>
            <label>Hedef kalori <input id="targetCalories" type="number" value="2850"></label>
            <label>Kişisel su hedefi (L, referans) <input id="targetWater" type="number" step="0.1" value="3"></label>
            <label>Hedef kilo (kg) <input id="targetWeight" type="number" step="0.1" value="76"></label>
            <label>Beslenme fazı
              <select id="nutritionGoalMode">
                <option value="auto">Otomatik / veriden çıkar</option>
                <option value="lean_gain">Lean Gain / Bulk</option>
                <option value="recomp">Maintenance / Recomp</option>
                <option value="cut">Cut / Yağ kaybı</option>
              </select>
            </label>
            <label>12W program başlangıcı <input id="programStartDate" type="date"></label>
            <label>Spor günü sınırı <select id="dayBoundaryHour"><option value="0">00:00</option><option value="2">02:00</option><option value="4" selected>04:00</option><option value="5">05:00</option></select></label>
            <label>Gece seansı cutoff <select id="settingsLateSessionCutoff"><option value="2">02:00</option><option value="4" selected>04:00</option><option value="6">06:00</option></select></label>
            <label>Çevre ölçüm gürültü eşiği (cm) <input id="measurementMdcCm" type="number" min="0.1" max="2" step="0.1" value="0.5"></label>
          </div>
        </div>

        <div class="card data-vault-card" style="margin-top:16px">
          <div class="section-head">
            <div>
              <h3>Data Vault <small class="version-chip">Portable Backup v2</small></h3>
              <p class="hint">Uygulama sürümü değişse bile kişisel verilerini tek dosyada taşı. İçe aktarmadan önce doğrulama ve otomatik geri dönüş noktası oluşturulur.</p>
            </div>
            <span id="vaultHealthBadge" class="plan-badge">Kontrol ediliyor…</span>
          </div>

          <div id="vaultSummary" class="grid four compact vault-summary"></div>

          <div class="vault-action-grid">
            <div class="vault-action-box">
              <strong>Tam Yedek</strong>
              <p>Tüm uygulama verileri + Photo Progress görselleri. En güvenli sürüm yükseltme dosyası.</p>
              <button id="vaultExportFull" class="primary" type="button">Tam Yedeği İndir</button>
            </div>
            <div class="vault-action-box">
              <strong>Hafif Veri Yedeği</strong>
              <p>Günlük, antrenman, beslenme, ölçüm, plan, ayar ve analiz verileri. Fotoğraflar dahil değildir.</p>
              <button id="vaultExportData" class="secondary" type="button">Veri Yedeğini İndir</button>
            </div>
            <div class="vault-action-box">
              <strong>Yerel Geri Dönüş Noktası</strong>
              <p>Tarayıcının IndexedDB alanına yerel checkpoint koyar. Yanlış import veya düzenleme için.</p>
              <button id="vaultCheckpointBtn" class="secondary" type="button">Checkpoint Oluştur</button>
            </div>
          </div>

          <div class="vault-import-zone">
            <div>
              <strong>Yedek Dosyasını İçe Aktar</strong>
              <p class="hint">v6.7 portable backup, eski Athlete Life OS JSON yedekleri ve ham veri JSON'u desteklenir.</p>
            </div>
            <label class="import-label vault-file-label">Dosya Seç
              <input id="vaultImportInput" type="file" accept="application/json,.json,.alosbackup">
            </label>
          </div>

          <div id="vaultImportPreview" class="vault-preview" hidden>
            <div class="section-head">
              <div>
                <h4 id="vaultPreviewTitle">Yedek bulundu</h4>
                <p id="vaultPreviewMeta" class="hint"></p>
              </div>
              <span id="vaultIntegrityBadge" class="plan-badge">--</span>
            </div>
            <div id="vaultPreviewCounts" class="grid four compact"></div>
            <div class="vault-mode-row">
              <button id="vaultMergeBtn" type="button" class="secondary">Mevcut Veriye Birleştir</button>
              <button id="vaultReplaceBtn" type="button" class="danger-btn">Tam Geri Yükle</button>
              <button id="vaultCancelImport" type="button" class="secondary">Vazgeç</button>
            </div>
            <div class="insight-box neutral">
              <b>Birleştir:</b> mevcut veriyi korur, yedekteki eksik tarihleri ekler ve aynı kayıtlarda yedek verisini kullanır.
              <b>Tam Geri Yükle:</b> mevcut kişisel veriyi yedekteki veriyle değiştirir. Her iki işlemden hemen önce otomatik checkpoint oluşturulur.
            </div>
          </div>

          <div class="vault-checkpoints">
            <div class="section-head">
              <div><h4>Yerel Checkpoint'ler</h4><p class="hint">Aynı tarayıcı/origin içinde tutulur; dış yedek dosyasının yerine geçmez.</p></div>
              <button id="vaultRefreshCheckpoints" type="button" class="secondary">Yenile</button>
            </div>
            <div id="vaultCheckpointList"></div>
          </div>

          <div class="vault-status-row">
            <span id="backupStatus" class="save-status"></span>
            <small id="vaultLastBackupText" class="hint"></small>
          </div>
        </div>

        <div class="card system-integrity-card" style="margin-top:16px">
          <div class="section-head">
            <div>
              <h3>System Integrity / Engine Mesh Test <small class="version-chip">v9.2.1 Fixture Isolation</small></h3>
              <p class="hint">Coach, training, nutrition, pain, recovery, adherence, body map, capability, guided runner ve Data Vault bağlantılarını geçici sandbox verisiyle test eder. Kişisel kayıtlarını değiştirmez.</p>
            </div>
            <span id="systemIntegrityBadge" class="plan-badge">TEST EDİLMEDİ</span>
          </div>
          <div id="systemIntegritySummary" class="grid four compact"></div>
          <div class="integrity-actions">
            <button id="runSystemIntegrity" type="button" class="primary">Tüm Motorları Test Et</button>
            <button id="copySystemIntegrity" type="button" class="secondary">Rapor Özeti</button>
          </div>
          <div id="systemIntegrityProgress" class="insight-box neutral" style="margin-top:10px">Test henüz çalıştırılmadı.</div>
          <div id="systemIntegrityResults" class="integrity-results"></div>
        </div>
      </section>
    </main>
  </div>

  <dialog id="socialDialog">
    <form method="dialog" class="dialog-card">
      <h3>Sürpriz Sosyal Plan</h3>
      <p>Planı eklediğinde uyku ve antrenman etkisi yeniden hesaplanır.</p>
      <label>Plan türü
        <select id="socialType"><option>Arkadaşlarla dışarı</option><option>Aile</option><option>Yemek</option><option>Sinema</option><option>Diğer</option></select>
      </label>
      <label>Başlangıç <input id="socialStart" type="time" value="21:00"></label>
      <label>Bitiş <input id="socialEnd" type="time" value="00:30"></label>
      <label>Öncelik
        <select id="socialPriority"><option>Normal</option><option>Önemli</option><option>Kaçırmak istemiyorum</option></select>
      </label>
      <div class="dialog-actions">
        <button value="cancel" class="secondary">Vazgeç</button>
        <button id="saveSocialBtn" value="default" class="primary">Planı Ekle</button>
      </div>
    </form>
  </dialog>



  <dialog id="gapBackfillDialog" class="record-edit-dialog">
    <form method="dialog" class="dialog-card record-edit-card">
      <div class="section-head">
        <div>
          <h3 id="gapBackfillTitle">Geçmiş Antrenmanı Kaydet</h3>
          <p id="gapBackfillSubtitle" class="hint"></p>
        </div>
      </div>
      <div class="form-grid">
        <label>Yaklaşık başlangıç saati
          <input id="gapBackfillTime" type="time">
        </label>
        <label>Süre (dk)
          <input id="gapBackfillDuration" type="number" min="0" step="5" value="60">
        </label>
        <label>Session RPE
          <input id="gapBackfillRpe" type="number" min="0" max="10" step="0.5" value="7">
        </label>
        <label>Planın ne kadarı tamamlandı?
          <select id="gapBackfillCompletion">
            <option value="100">Tamamı / %100</option>
            <option value="75">%75 civarı</option>
            <option value="50">%50 civarı</option>
          </select>
        </label>
        <label class="span-2">Not
          <input id="gapBackfillNote" type="text" placeholder="Hatırladığın ek bilgi">
        </label>
      </div>
      <div class="insight-box warn" style="margin-top:12px">
        Quick Backfill ayrıntılı set verisi değildir. Kas stimulus/recovery hesabına <b>orta güven</b> ile katılır; PR ve progresyon testlerinde kullanılmaz.
      </div>
      <div class="dialog-actions">
        <button value="cancel" class="secondary">Vazgeç</button>
        <button id="gapBackfillSave" type="button" class="primary">Geçmiş Seansı Kaydet</button>
      </div>
    </form>
  </dialog>


  <dialog id="nutritionEditDialog" class="record-edit-dialog">
    <form method="dialog" class="dialog-card record-edit-card">
      <div class="section-head">
        <div><h3 id="nutritionEditTitle">Besin Kaydını Düzenle</h3><p id="nutritionEditSubtitle" class="hint"></p></div>
      </div>
      <div class="form-grid">
        <label>Öğün
          <select id="nutritionEditMeal">
            <option>Kahvaltı</option><option>Öğle</option><option>Akşam</option>
            <option>Antrenman Öncesi</option><option>Antrenman Sonrası</option>
            <option>Atıştırmalık</option><option>İş Molası</option>
          </select>
        </label>
        <label>Besin <select id="nutritionEditFood"></select></label>
        <label>Porsiyon <input id="nutritionEditServings" type="number" min="0.01" step="0.25" value="1"></label>
        <label>Saat <input id="nutritionEditTime" type="time"></label>
      </div>
      <div id="nutritionEditPreview" class="nutrition-edit-preview"></div>
      <div class="dialog-actions">
        <button value="cancel" class="secondary">Vazgeç</button>
        <button id="nutritionEditSaveBtn" type="button" class="primary">Değişiklikleri Kaydet</button>
      </div>
    </form>
  </dialog>

  <dialog id="recordEditDialog" class="record-edit-dialog">
    <form method="dialog" class="dialog-card record-edit-card">
      <div class="section-head">
        <div><h3 id="recordEditTitle">Kaydı Düzenle</h3><p id="recordEditSubtitle" class="hint"></p></div>
      </div>
      <div id="recordEditFields" class="form-grid"></div>
      <div id="recordEditWarning" class="insight-box neutral" style="margin-top:12px" hidden></div>
      <div class="dialog-actions">
        <button value="cancel" class="secondary">Vazgeç</button>
        <button id="recordEditSaveBtn" value="default" class="primary" type="button">Değişiklikleri Kaydet</button>
      </div>
    </form>
  </dialog>

  <div id="recordUndoToast" class="record-undo-toast" hidden>
    <span id="recordUndoText">Kayıt güncellendi.</span>
    <button id="recordToastUndo" type="button">Geri Al</button>
  </div>



  <nav class="quick-nav" aria-label="Hızlı gezinme">
    <button data-goto="today">Bugün</button>
    <button data-goto="training">Antrenman</button>
    <button data-goto="coach">Koç</button>
    <button data-goto="nutrition">Beslenme</button>
    <button data-goto="reports">Rapor</button>
    <button data-goto="records">Kayıtlar</button>
  </nav>


  <script src="nutrition-library.js?v=7.19"></script>
  <script src="nutrition-ledger-engine.js?v=7.17"></script>
  <script src="water-ledger-engine.js?v=7.18"></script>
  <script src="hydration-intelligence-engine.js?v=7.19"></script>
  <script src="health-state-engine.js?v=7.15"></script>
  <script src="capability-catalog.js?v=9.2.3"></script>
  <script src="exercise-knowledge-library.js"></script>
  <script src="load-prescription-engine.js?v=7.14"></script>
  <script src="physiological-impact-engine.js?v=7.14"></script>
  <script src="engine-bus.js?v=8.0"></script>
  <script src="data-lineage-engine.js?v=8.0"></script>
  <script src="schema-migration-engine.js?v=9.0"></script>
  <script src="event-store-engine.js?v=8.0"></script>
  <script src="app.js?v=9.2.6"></script>
  <script src="nutrition-record-engine.js?v=7.17"></script>
  <script src="periodic-trend-engine.js?v=7.17"></script>
  <script src="movement-intelligence-engine.js?v=7.15"></script>
  <script src="ad-hoc-session-engine.js?v=7.15"></script>
  <script src="pain-intelligence-core.js"></script>
  <script src="pain-intelligence-engine.js"></script>
  <script src="bodymap3d.js"></script>
  <script src="performance-trend-v2.js?v=8.0"></script>
  <script src="personal-calibration-engine.js?v=8.0"></script>
  <script src="tissue-load-engine.js?v=8.0"></script>
  <script src="adaptive-nutrition-engine.js?v=8.0"></script>
  <script src="sports-science-policy.js?v=9.2"></script>
  <script src="adaptive-coach-solver.js?v=9.1"></script>
  <script src="canonical-session-engine.js?v=9.0"></script>
  <script src="training-session-service.js?v=9.0"></script>
  <script src="adaptive-intelligence.js?v=9.0"></script>
  <script src="record-manager.js"></script>
  <script src="adherence-engine.js"></script>
  <script src="gap-reconciliation.js"></script>
  <script src="athlete-profile-engine.js?v=9.2.3"></script>
  <script src="nutrition-impact-engine.js?v=7.20"></script>
  <script src="rest-interval-engine.js"></script>
  <script src="guided-workout-core.js?v=7.14"></script>
  <script src="substitution-intelligence-core.js?v=7.14"></script>
  <script src="guided-workout-engine.js?v=9.2"></script>
  <script src="backup-vault.js?v=9.2.6"></script>
  <script src="system-integrity-engine.js?v=9.2.1"></script>
  <script src="training-mesh-dashboard.js?v=7.15"></script>
  <script src="release-integrity-v8.js?v=9.0"></script>
  <script src="architecture-bootstrap.js?v=9.0"></script>
  <script src="athlete-coordinator.js?v=9.0"></script>
</body>
</html>
