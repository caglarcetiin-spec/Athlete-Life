<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Athlete Life OS</title>
  <link rel="stylesheet" href="styles.css" />
  <link rel="manifest" href="manifest.json" />
  <meta name="theme-color" content="#0d1117" />
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="logo">A</div>
        <div>
          <h1>Athlete Life OS <span class="version-pill">v9.2.5</span></h1>
          <p>Planla · Uygula · Ölç · Öğren · Yeniden Planla</p>
        </div>
      </div>
      <nav>
        <button class="nav-btn active" data-page="today">Bugün</button>
        <button class="nav-btn" data-page="week">Haftam</button>
        <button class="nav-btn" data-page="training">Antrenman</button>
        <button class="nav-btn" data-page="nutrition">Beslenme</button>
        <button class="nav-btn" data-page="analytics">Analiz</button>
        <button class="nav-btn" data-page="detailed">Detaylı Analiz</button>
        <button class="nav-btn" data-page="coach">Koç</button>
        <button class="nav-btn" data-page="character">Çağlar</button>
        <button class="nav-btn" data-page="reports">Raporlar</button>
        <button class="nav-btn" data-page="records">Kayıtlar</button>
        <button class="nav-btn" data-page="settings">Ayarlar</button>
      </nav>
      <div class="sidebar-note">
        <strong>Tek veri portalı</strong>
        <span>Girdiğin veriler tüm ekranları besler.</span>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div>
          <h2 id="pageTitle">Bugün</h2>
          <p id="dateLabel"></p>
        </div>
        <div class="topbar-actions">
          <button id="quickBackupBtn" class="secondary quick-backup-btn" type="button" title="Tüm uygulama verilerini ve Photo Progress görsellerini yedekle">⬇ Tüm Verileri Yedekle</button>
          <button id="quickSocialBtn" class="primary" type="button">+ Sürpriz Plan</button>
        </div>
      </header>

      <section id="today" class="page active">

        <div class="card command-center">
          <div class="section-head">
            <div><h3>Life OS Command Center</h3><p class="hint">Bugün, yarın ve 12 haftalık döngünün tek bakışta özeti.</p></div>
            <div id="engineStatus" class="engine-status">Motor hazırlanıyor…</div>
          </div>
          <div class="command-grid">
            <button class="command-tile" data-command="training"><span>BUGÜN</span><strong id="cmdTodayTraining">--</strong><small id="cmdTodayTime">--</small></button>
            <button class="command-tile" data-command="coach"><span>YARIN</span><strong id="cmdTomorrowTraining">--</strong><small id="cmdTomorrowReadiness">--</small></button>
            <button class="command-tile" data-command="coach"><span>12 HAFTA</span><strong id="cmdProgramWeek">--</strong><small id="cmdProgramPhase">--</small></button>
            <button class="command-tile" data-command="reports"><span>RECOVERY</span><strong id="cmdRecovery">--</strong><small id="cmdRecoveryNote">--</small></button>
          </div>
        </div>

        <div class="grid four">
          <div class="card metric"><span>Readiness</span><strong id="readinessScore">--</strong><small id="readinessText">Veri bekleniyor</small></div>
          <div class="card metric"><span>Uyku</span><strong id="sleepHours">--</strong><small id="sleepText">Saat</small></div>
          <div class="card metric"><span>Günlük yük</span><strong id="dailyLoad">--</strong><small>İş + antrenman + stres</small></div>
          <div class="card metric"><span>Life Balance</span><strong id="lifeBalance">--</strong><small>Bugünkü denge</small></div>
        </div>

        <div id="gapReconciliationCard" class="card gap-reconciliation-card" hidden>
          <div class="section-head">
            <div>
              <h3>Eksik Günleri Tamamla <small class="version-chip">Gap Reconciliation</small></h3>
              <p class="hint">Uygulama kapalıyken kayıt olmayan planlı günler otomatik olarak “kaçırıldı” sayılmaz. Önce sen doğrularsın.</p>
            </div>
            <span id="gapPendingBadge" class="plan-badge">0 gün</span>
          </div>
          <div id="gapReconciliationIntro" class="insight-box neutral"></div>
          <div id="gapReconciliationList" class="gap-list"></div>
        </div>

        <div class="card adherence-guardian-card">
          <div class="section-head">
            <div>
              <h3>Adherence Guardian <small class="version-chip">v6.8</small></h3>
              <p class="hint">Planlanan ile gerçekleşeni izler. Program uyumu ve adaptasyon başarısı birbirinden ayrı değerlendirilir.</p>
            </div>
            <div class="guardian-badges">
              <span id="guardianAdherenceBadge" class="plan-badge">Uyum --</span>
              <span id="guardianAdaptationBadge" class="plan-badge">Adaptasyon --</span>
            </div>
          </div>
          <div id="guardianAlerts" class="guardian-alerts"></div>
          <div id="guardianTodayPlan" class="guardian-plan-strip"></div>
          <div class="guardian-context-row">
            <label>Sapma nedeni (opsiyonel)
              <select id="deviationReason">
                <option value="">Otomatik değerlendir</option>
                <option value="sleep_debt">Uyku borcu / recovery</option>
                <option value="work">İş / vardiya</option>
                <option value="social">Sosyal plan</option>
                <option value="pain">Ağrı / eklem</option>
                <option value="time">Zaman sıkışması</option>
                <option value="energy">Enerji / yorgunluk</option>
                <option value="other">Diğer</option>
              </select>
            </label>
            <button id="saveDeviationReason" type="button" class="secondary">Nedeni Kaydet</button>
          </div>
        </div>

        <div class="grid two">
          <div class="card">
            <div class="section-head">
              <div><h3>Sabah Check-in</h3><p>Bugünkü optimizer'ın temel verileri.</p></div>
              <div class="save-wrap"><span id="dailySaveStatus" class="save-status"></span><button id="saveDailyBtn" class="primary" type="button">Kaydet</button></div>
            </div>
            <div class="form-grid">
              <label>Yatış <input id="bedTime" type="time" value="00:30"></label>
              <label>Uykuya dalış <input id="sleepTime" type="time" value="00:45"></label>
              <label>Uyanış <input id="wakeTime" type="time" value="08:45"></label>
              <label>Gece uyanıklığı (dk) <input id="nightAwake" type="number" min="0" value="0"></label>
              <label>Uyku kalitesi (1-5) <input id="sleepQuality" type="number" min="1" max="5" value="4"></label>
              <label>Enerji (1-5) <input id="energy" type="number" min="1" max="5" value="4"></label>
              <label>Motivasyon (1-5) <input id="motivation" type="number" min="1" max="5" value="4"></label>
              <label>Kas ağrısı (1-5) <input id="soreness" type="number" min="1" max="5" value="2"></label>
              <label>Eklem rahatlığı (1-5) <input id="joint" type="number" min="1" max="5" value="5"></label>
              <label>Stres (1-5) <input id="stress" type="number" min="1" max="5" value="2"></label>
              <label>Kilo (kg) <input id="weight" type="number" step="0.1" value="72"></label>
              <label>Bel (cm) <input id="waist" type="number" step="0.1" value="78"></label>
              <label>Koşu km <input id="runKm" type="number" step="0.1" value="0"></label>
              <label>Koşu süre dk <input id="runMinutes" type="number" step="1" value="0"></label>
              <label>Koşu RPE <input id="runRpe" type="number" min="0" max="10" value="0"></label>
            </div>

            <div class="health-state-box">
              <div class="section-head compact">
                <div><h4>Sağlık / Halsizlik Durumu</h4><p class="hint">Tanı koymaz; bugünkü training load, readiness ve Coach kararına bağlanır.</p></div>
                <span id="healthStateBadge" class="plan-badge">NORMAL</span>
              </div>
              <div class="health-grid">
                <label>Durum
                  <select id="healthStatus">
                    <option value="normal">Normal</option>
                    <option value="fatigued">Halsiz / yorgun</option>
                    <option value="mild_illness">Hafif hastalık belirtileri</option>
                    <option value="sick">Hastayım</option>
                    <option value="recovering">Hastalık sonrası toparlanıyorum</option>
                  </select>
                </label>
                <label>Halsizlik (0–10)<input id="fatigueLevel" type="number" min="0" max="10" step="1" value="0"></label>
                <label>Hastalık şiddeti (0–10)<input id="illnessSeverity" type="number" min="0" max="10" step="1" value="0"></label>
                <label>Not<input id="healthNote" type="text" placeholder="örn. boğaz ağrısı, genel halsizlik"></label>
              </div>
              <div class="health-flags">
                <label><input id="healthFever" type="checkbox"> Ateş / ateş hissi</label>
                <label><input id="healthCough" type="checkbox"> Öksürük / solunum yolu</label>
                <label><input id="healthSoreThroat" type="checkbox"> Boğaz ağrısı</label>
                <label><input id="healthHeadache" type="checkbox"> Baş ağrısı</label>
                <label><input id="healthGI" type="checkbox"> Mide-bağırsak</label>
                <label><input id="healthDizziness" type="checkbox"> Baş dönmesi</label>
                <label><input id="healthChestBreathing" type="checkbox"> Göğüs / nefes sorunu</label>
              </div>
              <div id="healthStateAdvice" class="insight-box neutral">Sağlık durumunu girince Coach burada yorumlayacak.</div>
            </div>
          </div>

          <div class="card">
            <div class="section-head">
              <div><h3>Bugünün Planı</h3><p>Vardiya + uyku + sosyal plan + antrenman durumuna göre.</p></div>
              <button id="optimizeTodayBtn" class="secondary">Yeniden Optimize Et</button>
            </div>
            <div id="todayPlan" class="timeline"></div>
          </div>
        </div>


        <div class="card pain-card">
          <div class="section-head">
            <div>
              <h3>Pain / Joint Intelligence <small class="version-chip">v7.7</small></h3>
              <p class="hint">Bölge + sağ/sol + şiddet + tetikleyen hareket kaydedilir. Tanı koymaz; Coach yük yönetimi ve 3D hotspot için kullanır.</p>
            </div>
            <div id="painRiskBadge" class="plan-badge">0/10</div>
          </div>

          <div class="pain-entry-grid">
            <label>Tarih<input id="painLogDate" type="date"></label>
            <label>Bölge
              <select id="painJoint">
                <option value="shoulder">Omuz</option><option value="elbow">Dirsek</option>
                <option value="wrist">El bileği</option><option value="hand">El / avuç</option>
                <option value="neck">Boyun</option><option value="upperBack">Üst sırt</option>
                <option value="lowBack">Bel / lumbar</option><option value="hip">Kalça</option>
                <option value="knee">Diz</option><option value="ankle">Ayak bileği</option>
                <option value="foot">Ayak</option>
              </select>
            </label>
            <label>Taraf
              <select id="painSide">
                <option value="left">Sol</option><option value="right">Sağ</option>
                <option value="bilateral">İki taraf</option><option value="midline">Orta hat</option>
              </select>
            </label>
            <label>Şiddet (0–10)<input id="painSeverity" type="number" min="0" max="10" step="1" value="0"></label>
            <label>Ne zaman?
              <select id="painContext">
                <option value="movement">Hareket sırasında</option><option value="after_training">Antrenman sonrası</option>
                <option value="rest">Dinlenirken</option><option value="morning">Sabah / ilk hareket</option>
                <option value="daily">Günlük yaşamda</option>
              </select>
            </label>
            <label>Başlangıç
              <select id="painOnset">
                <option value="gradual">Kademeli</option><option value="sudden">Ani</option><option value="trauma">Travma sonrası</option>
              </select>
            </label>
            <label>Hissettiğin durum
              <select id="painSensation">
                <option value="ache">Sızı / ağrı</option><option value="sharp">Keskin</option>
                <option value="stiffness">Sertlik</option><option value="burning">Yanma</option>
                <option value="tingling">Uyuşma / karıncalanma</option><option value="other">Diğer</option>
              </select>
            </label>
            <label>Kaç gündür?<input id="painDurationDays" type="number" min="0" max="3650" step="1" value="0"></label>
            <label class="span-2">Tetikleyen / artıran hareket
              <select id="painTriggerExercise"><option value="">Belirli hareket yok / bilmiyorum</option></select>
            </label>
            <label class="span-2">Not<input id="painNote" type="text" placeholder="örn. planche lean'de wrist extension ile artıyor"></label>
          </div>

          <div class="pain-redflag-grid">
            <label><input id="painFlagSwelling" type="checkbox"> Belirgin şişlik</label>
            <label><input id="painFlagNumbness" type="checkbox"> Uyuşma / karıncalanma</label>
            <label><input id="painFlagWeakness" type="checkbox"> Yeni güç kaybı</label>
            <label><input id="painFlagInstability" type="checkbox"> Boşa çıkma / instabilite</label>
            <label><input id="painFlagCannotUse" type="checkbox"> Üzerine basamama / uzvu kullanamama</label>
            <label><input id="painFlagNightRestPain" type="checkbox"> Belirgin gece / istirahat ağrısı</label>
          </div>

          <div class="pain-entry-actions">
            <button id="savePainLogBtn" class="primary" type="button">Ağrı Kaydını Ekle</button>
            <span id="painSaveStatus" class="save-status"></span>
          </div>

          <div id="painCoachNote" class="insight-box neutral" style="margin-top:12px">Ağrı verisi kaydedildiğinde hareket uyumluluğu burada görünür.</div>
          <div id="activePainList" class="active-pain-list"></div>
          <div id="painMovementAdvice" class="pain-movement-advice"></div>
        </div>

        <div class="grid two">
          <div class="card">
            <div class="section-head">
              <div><h3>Bugünkü Vardiya</h3><p>İş günü, izin veya yıllık izin.</p></div>
              <div class="save-wrap"><span id="shiftSaveStatus" class="save-status"></span><button id="saveShiftBtn" class="primary" type="button">Vardiyayı Kaydet</button></div>
            </div>
            <div class="form-grid">
              <label>Durum
                <select id="todayWorkStatus">
                  <option value="off">İzin</option>
                  <option value="work">Çalışma</option>
                  <option value="annual">Yıllık izin</option>
                </select>
              </label>
              <label>Vardiya
                <select id="todayShift">
                  <option value="morning">Sabah 10:00–18:00</option>
                  <option value="mid">Ara 12:00–20:00</option>
                  <option value="evening">Akşam 14:00–22:00</option>
                </select>
              </label>
              <label>İş yoğunluğu (1-5) <input id="workIntensity" type="number" min="1" max="5" value="3"></label>
              <label>Adım <input id="steps" type="number" min="0" value="9000"></label>
            </div>
          </div>

          <div class="card">
            <div class="section-head"><div><h3>Feragat Analizi</h3><p>Sürpriz planın bugüne etkisi.</p></div></div>
            <div id="tradeoffBox" class="insight-box neutral">Henüz sürpriz plan eklenmedi.</div>
          </div>
        </div>
      </section>

      <section id="week" class="page">
        <div class="card">
          <div class="section-head">
            <div><h3>Haftalık Vardiya Planı</h3><p>Pazar günü yeni haftayı buradan gir.</p></div>
            <button id="optimizeWeekBtn" class="primary">Haftayı Optimize Et</button>
          </div>
          <div id="weekPlanner" class="week-grid"></div>
        </div>
        <div class="card">
          <div class="section-head"><div><h3>Optimize Edilmiş Hafta</h3><p>Uyku, antrenman ve vardiya önerileri.</p></div></div>
          <div id="weekOutput" class="week-output"></div>
        </div>
      </section>

      <section id="training" class="page">

        <div class="card training-plan-card">
          <div class="training-date-nav" aria-label="Antrenman günü seçimi">
            <button id="trainingPrevDay" type="button" class="secondary" aria-label="Önceki gün">←</button>
            <div class="training-date-focus">
              <span>SEÇİLİ ANTRENMAN GÜNÜ</span>
              <strong id="trainingSelectedDateLabel">--</strong>
            </div>
            <button id="trainingTodayDay" type="button" class="secondary">Bugün</button>
            <button id="trainingNextDay" type="button" class="secondary" aria-label="Sonraki gün">→</button>
          </div>
          <div class="section-head">
            <div>
              <h3>Bu Haftanın Antrenman Planı</h3>
              <p class="hint">Çalışma programın, günlük uyku/readiness ve Çağlar Hybrid Mass 12W sistemine göre otomatik hazırlanır.</p>
            </div>
            <button id="rebuildTrainingPlanBtn" class="secondary" type="button">Planı Yenile</button>
          </div>
          <div id="weeklyTrainingPlan" class="weekly-training-plan"></div>
        </div>

        <div class="card today-plan-card" style="margin-top:16px">
          <div class="section-head">
            <div>
              <h3 id="selectedWorkoutHeading">Seçili Günün Hazır Antrenmanı</h3>
              <p class="hint">Önce planı uygula, sonra gerçekleşen set/tekrar/yük değerlerini aşağıdaki kayıt alanına işle.</p>
            </div>
            <div id="todayPlanBadge" class="plan-badge">--</div>
          </div>
          <div id="todayTrainingPlan" class="today-training-plan"></div>
          <button id="guidedStartToday" type="button" class="primary">Bu Planı Guided Runner’da Başlat</button>
          <div id="todayPlanReason" class="insight-box" style="margin-top:12px"></div>
          <div class="canonical-sync-strip">
            <span id="trainingPlanSyncBadge" class="plan-badge">CANONICAL</span>
            <div id="trainingPlanSyncDetail" class="hint">Haftalık Plan → Bugünün Hazır Antrenmanı → Guided Runner senkronizasyonu kontrol ediliyor…</div>
          </div>
        </div>


        <div class="card late-session-card">
          <section class="unified-training-status" aria-label="Veri ve plan eşleşmesi">
            <h3>Tek Plan · Ortak Sporcu Verisi</h3>
            <p id="athleteSyncStatus" role="status">Motorlar hazırlanıyor…</p>
            <p id="athleteSyncErrors" role="alert"></p>
            <button id="refreshAthleteState" class="secondary" type="button">Verileri ve Analizleri Yenile</button>
            <p class="hint">Önerilen antrenman ve gerçekleşen setler ayrı tutulur. Toparlanma/doku yükü puanları model tahminidir; ölçülmüş fizyolojik değer veya sakatlık olasılığı değildir.</p>
          </section>
          <section class="guided-shared-preview" aria-label="Guided Runner ortak plan önizlemesi">
            <h3>Guided Workout Runner · Seçili Günün Programı</h3>
            <p id="guidedPreviewIdentity" class="hint"></p>
            <div id="guidedPrescriptionPreview" class="today-training-plan"></div>
            <button id="guidedStartWorkout" type="button" class="primary">Seçili Günün Ortak Planını Başlat</button>
            <button id="guidedResumeWorkout" type="button" class="secondary" hidden>Kayıtlı Oturuma Dön</button>
          </section>
          <details class="catchup-options">
          <summary>Başka tarihe antrenman kaydet / telafi yap</summary>
          <div class="section-head">
            <div>
              <h3>Session Router · Gece / Telafi Antrenmanı</h3>
              <p class="hint">Gerçek antrenman zamanı ile bağlı olduğu program gününü ayrı saklar. Böylece 00:00 sonrası antrenman kaybolmaz.</p>
            </div>
            <div id="sessionRouterBadge" class="plan-badge">--</div>
          </div>
          <div class="form-grid">
            <label>Seansı hangi plana bağlayalım?
              <select id="sessionAttributionMode"></select>
            </label>
            <label id="sessionCustomDateWrap" hidden>Özel plan tarihi<input id="sessionCustomDate" type="date"></label>
            <label>Gece seansı cutoff
              <select id="lateSessionCutoff"><option value="2">02:00</option><option value="4" selected>04:00</option><option value="6">06:00</option></select>
            </label>
          </div>
          <div id="sessionRouterSummary" class="insight-box neutral" style="margin-top:12px"></div>
          <div class="guided-router-actions">
            <button id="guidedStartCatchup" type="button" class="secondary">Seçilen Tarihe Ayrı Oturum Başlat</button>
            <span id="guidedRouterHint" class="hint">Plan tarihi Session Router seçimine göre alınır.</span>
          </div>
          </details>
        </div>

        <div id="guidedWorkoutCard" class="card guided-workout-card" hidden>
          <div class="section-head guided-head">
            <div>
              <h3>Guided Workout Runner <small class="version-chip">v9.2 Program Engine Sync</small></h3>
              <p class="hint">Guided + manuel kayıtlar tek akışta uzlaştırılır. Daha önce elle yaptığın setleri algılar, tekrar yaptırmadan ilk eksik setten devam eder.</p>
            </div>
            <div class="guided-head-badges">
              <span id="guidedIntegrityBadge" class="plan-badge">DATA CHECK</span>
              <span id="guidedSessionStatus" class="plan-badge">HAZIR</span>
              <span id="guidedSessionElapsed" class="plan-badge">00:00</span>
            </div>
          </div>

          <div class="guided-session-tools" aria-label="Guided antrenman bakım araçları">
            <button id="guidedSyncPlan" type="button" class="secondary">Planı Eşitle</button>
            <button id="guidedResetTimer" type="button" class="secondary">Süreyi Sıfırla</button>
            <button id="guidedRestartWorkout" type="button" class="danger">Antrenmanı Baştan Başlat</button>
            <small>İlk setten önce ortak plan güncellenir; başladıktan sonra reçete korunur. Baştan başlatma kayıtları silmez ve ilk eksik setten devam eder.</small>
          </div>

          <div class="guided-progress-top">
            <div><span>PLAN</span><strong id="guidedPlanTitle">--</strong><small id="guidedPlanDate">--</small></div>
            <div><span>HAREKET</span><strong id="guidedExerciseProgress">--</strong><small id="guidedExerciseName">--</small></div>
            <div><span>SET</span><strong id="guidedSetProgress">--</strong><small id="guidedPrescription">--</small></div>
            <div><span>SONRAKİ DİNLENME</span><strong id="guidedRestTarget">--</strong><small id="guidedWorkWindow">--</small></div>
          </div>

          <div id="guidedPlanQueue" class="guided-plan-queue"></div>

          <div class="guided-stage">
            <div class="guided-current">
              <span id="guidedMovementClass">--</span>
              <h2 id="guidedCurrentExercise">Antrenmanı başlat</h2>
              <p id="guidedCurrentInstruction">Session Router’dan planı seçip “Seçili Antrenmanı Başlat” düğmesine bas.</p>
              <div id="guidedTargetChips" class="guided-target-chips"></div>
            </div>

            <div class="guided-stopwatch-wrap">
              <span id="guidedTimerLabel">SET TIMER</span>
              <strong id="guidedWorkTimer">00:00.0</strong>
              <div id="guidedTimerFeedback" class="guided-timer-feedback neutral">Set başlamadı.</div>
              <div class="guided-main-actions">
                <button id="guidedStartSet" type="button" class="primary guided-big-btn">Seti Başlat</button>
                <button id="guidedStopSet" type="button" class="danger-btn guided-big-btn" hidden>Seti Durdur</button>
              </div>
            </div>
          </div>

          <div id="guidedResultPanel" class="guided-result-panel" hidden>
            <div class="section-head"><div><h4>Set Sonucu</h4><p id="guidedResultHint" class="hint"></p></div><span id="guidedMeasuredDuration" class="plan-badge">--</span></div>
            <div class="form-grid guided-result-grid">
              <label id="guidedResultValueLabel">Tekrar<input id="guidedResultValue" type="number" min="0" step="1"></label>
              <label id="guidedResultLoadLabel">Yük (kg)<input id="guidedResultLoad" type="number" min="0" step="0.5"></label>
              <label>RIR / Hold reserve<input id="guidedResultRir" type="number" min="0" max="5" step="0.5" value="2"></label>
              <label>Set notu<input id="guidedResultNote" type="text" placeholder="örn. temiz, transition yavaşladı"></label>
            </div>
            <div class="guided-result-actions">
              <button id="guidedSaveSet" type="button" class="primary">Seti Kaydet ve Dinlen</button>
              <button id="guidedRedoSet" type="button" class="secondary">Timerı Yeniden Başlat</button>
            </div>
          </div>

          <div id="guidedRestPanel" class="guided-rest-panel" hidden>
            <div>
              <span>SET ARASI DİNLENME</span>
              <strong id="guidedRestCountdown">00:00</strong>
              <small id="guidedRestActual">Gerçek dinlenme: 00:00</small>
            </div>
            <div class="guided-rest-copy">
              <strong id="guidedRestMessage">Toparlan.</strong>
              <p id="guidedRestRange" class="hint"></p>
            </div>
            <div class="guided-rest-actions">
              <button id="guidedNextSet" type="button" class="primary">Sıradaki Seti Başlat</button>
              <button id="guidedRestPlus30" type="button" class="secondary">+30 sn hedef</button>
              <button id="guidedSkipRest" type="button" class="secondary">Dinlenmeyi Bitir</button>
            </div>
          </div>

          <div id="guidedExerciseDone" class="guided-exercise-done" hidden>
            <div><strong>Hareket tamamlandı.</strong><span id="guidedExerciseDoneSummary"></span></div>
            <button id="guidedNextExercise" type="button" class="primary">Sonraki Harekete Geç</button>
          </div>

          <div id="guidedSubstitutionPanel" class="guided-substitution-panel" hidden>
            <div class="section-head">
              <div><h4>Farklı hareket algılandı</h4><p id="guidedSubstitutionTitle" class="hint">Planlanan hareket ile kaydettiğin hareket farklı.</p></div>
              <span id="guidedSubstitutionFit" class="plan-badge">--</span>
            </div>
            <div id="guidedSubstitutionCompare" class="guided-substitution-compare"></div>
            <div id="guidedSubstitutionAnalysis" class="insight-box warn"></div>
            <div class="guided-substitution-actions">
              <button id="guidedAcceptSubstitution" type="button" class="primary">Yerine Say → Sonraki Harekete Geç</button>
              <button id="guidedKeepExtra" type="button" class="secondary">Ekstra Olarak Tut · Planı Değiştirme</button>
            </div>
          </div>

          <div id="guidedPartialControls" class="guided-partial-controls" hidden>
            <div>
              <strong id="guidedPartialTitle">Planlanan setlerin altında bitir</strong>
              <small id="guidedPartialCopy">Yaptığın setler korunur; kalan setler yapılmadı olarak işlenir.</small>
            </div>
            <label>Neden?
              <select id="guidedPartialReason">
                <option value="fatigue">Yorgunluk / readiness düşük</option>
                <option value="performance_drop">Performans düştü</option>
                <option value="form_quality">Teknik / form kalitesi bozuldu</option>
                <option value="pain">Ağrı / eklem sinyali</option>
                <option value="time">Zaman kısıtı</option>
                <option value="other">Diğer</option>
              </select>
            </label>
            <button id="guidedCloseExercisePartial" type="button" class="secondary">Hareketi Burada Bitir → Sonraki Harekete Geç</button>
          </div>

          <div class="guided-footer-actions">
            <button id="guidedSkipExercise" type="button" class="secondary">Bu Hareketi Atla</button>
            <button id="guidedPauseSession" type="button" class="secondary">Seansı Duraklat</button>
            <button id="guidedEndSession" type="button" class="danger-btn">Antrenmanı Bitir</button>
          </div>
        </div>

        <div class="grid two guided-graph-grid">
          <div id="guidedTimingCard" class="card" hidden>
            <div class="section-head"><div><h3>Set Zamanlama Grafiği</h3><p class="hint">Her kaydedilen set için aktif set süresi ve zamanlama kalite skoru.</p></div><span id="guidedTimingAverage" class="plan-badge">--</span></div>
            <div class="guided-chart-wrap"><canvas id="guidedTimingChart"></canvas></div>
            <div id="guidedTimingDetails" class="guided-timing-details"></div>
          </div>
          <div id="guidedAutomationCard" class="card" hidden>
            <div class="section-head"><div><h3>Otomasyon Özeti</h3><p class="hint">Planlanan → gerçek set, work-time ve rest akışı.</p></div></div>
            <div id="guidedAutomationSummary" class="summary-list"></div>
            <div id="guidedCoachTimingAdvice" class="insight-box neutral" style="margin-top:10px"></div>
          </div>
        </div>

        <div class="grid two training-feedback-grid">
          <div class="card">
            <h3>Plan → Gerçekleşen</h3>
            <div id="planVsActual" class="summary-list"></div>
            <div id="sessionRestSummary" class="rest-session-summary"></div>
            <div id="liveAutoregulation" class="insight-box neutral" style="margin-top:12px">İlk set kaydından sonra canlı öneri burada oluşur.</div>
          </div>
          <div class="card">
            <div class="section-head"><div><h3>Seansı Tamamla</h3><p class="hint">Bu kayıt gelecekteki Koç kararlarını değiştirir.</p></div><button id="completeSessionBtn" class="primary" type="button">Seansı Tamamla</button></div>
            <div class="form-grid">
              <label>Session RPE (1–10)<input id="sessionRpe" type="number" min="1" max="10" step="0.5" value="7"></label>
              <label>Süre (dk)<input id="sessionDuration" type="number" min="0" step="5" value="75"></label>
              <label class="span-2">Not<input id="sessionNote" placeholder="örn. son iki sette bar hızı düştü"></label>
            </div>
            <div id="sessionCompleteStatus" class="save-status"></div>
          </div>
        </div>


        <div class="card adhoc-session-card">
          <div class="section-head">
            <div>
              <h3>Serbest / Plan Dışı Antrenman <small class="version-chip">Unified Physiology Mesh</small></h3>
              <p class="hint">Programın dışında yaptığın circuit, superset, kesintisiz kondisyon veya kısa ek seansı kaydet. Program uyumu sayılmaz; gerçek training load olarak analiz edilir.</p>
            </div>
            <span id="adhocDraftBadge" class="plan-badge">0 hareket</span>
          </div>

          <div class="adhoc-config-grid">
            <label>Seans yapısı
              <select id="adhocStructure">
                <option value="circuit">Circuit / ardışık hareketler</option>
                <option value="continuous">Kesintisiz yoğun devre</option>
                <option value="superset">Superset / giant set</option>
                <option value="straight_sets">Normal serbest setler</option>
                <option value="emom">EMOM</option>
                <option value="amrap">AMRAP</option>
                <option value="for_time">For Time</option>
              </select>
            </label>
            <label>Tur / round<input id="adhocRounds" type="number" min="1" max="20" step="1" value="3"></label>
            <label>Toplam süre (dk)<input id="adhocDuration" type="number" min="1" max="240" step="1" value="15"></label>
            <label>Session RPE<input id="adhocRpe" type="number" min="1" max="10" step="0.5" value="7"></label>
            <label>Hareket arası rest (sn)<input id="adhocExerciseRest" type="number" min="0" max="600" step="5" value="0"></label>
            <label>Tur arası rest (sn)<input id="adhocRoundRest" type="number" min="0" max="900" step="5" value="60"></label>
          </div>

          <div class="adhoc-add-grid">
            <label>Hareket<select id="adhocExerciseSelect"></select></label>
            <label id="adhocValueLabel">Tekrar / hold<input id="adhocValue" type="number" min="0.1" step="1" value="10"></label>
            <label id="adhocLoadLabel">Ek yük (kg)<input id="adhocLoad" type="number" min="0" step="0.5" value="0"></label>
            <label id="adhocDistanceLabel" hidden>Tur başına mesafe (m, opsiyonel)<input id="adhocDistanceM" type="number" min="0" step="1" value="0"></label>
            <button id="adhocAddMovement" type="button" class="secondary">Hareketi Devreye Ekle</button>
          </div>

          <div id="adhocDraftList" class="adhoc-draft-list"></div>
          <div class="adhoc-actions">
            <button id="adhocSaveSession" type="button" class="primary">Serbest Seansı Kaydet ve Analiz Et</button>
            <button id="adhocClearDraft" type="button" class="secondary">Taslağı Temizle</button>
          </div>
          <div id="adhocAnalysis" class="adhoc-analysis"></div>
          <div id="adhocHistory" class="adhoc-history"></div>
        </div>

        <div class="grid two">
          <div class="card">
            <div class="section-head"><div><h3>Antrenman Kaydı <small id="coachCatalogIntegrityBadge" class="version-chip">Katalog kontrolü…</small></h3><p>Hareket tipi otomatik belirlenir: statik=saniye, dinamik=tekrar, koşu=km, mobility=dk.</p></div><button id="addExerciseBtn" class="primary">Hareket Ekle</button></div>
            <div class="form-grid">
              <label>Ekipman
                <select id="exerciseEquipmentFilter"><option value="all">Tüm ekipmanlar</option></select>
              </label>
              <label>Hareket
                <select id="exerciseSelect"></select>
              </label>
              <label id="exerciseLoadLabel">Ek yük (kg) <input id="exerciseLoad" type="number" step="0.5" value="0"></label>
              <label id="setLabel1">Set 1 <input id="set1" type="number" step="0.1"></label>
              <label id="setLabel2">Set 2 <input id="set2" type="number" step="0.1"></label>
              <label id="setLabel3">Set 3 <input id="set3" type="number" step="0.1"></label>
              <label id="setLabel4">Set 4 <input id="set4" type="number" step="0.1"></label>
              <label id="setLabel5">Set 5 <input id="set5" type="number" step="0.1"></label>
              <label id="exerciseRirLabel">RIR <input id="exerciseRir" type="number" min="0" max="5" value="2"></label>
              <label>Planlanan dinlenme (sn)
                <input id="exerciseRestPlanned" type="number" min="0" step="15" value="120">
              </label>
              <label>1→2 set dinlenme (sn)<input id="rest12" type="number" min="0" step="5"></label>
              <label>2→3 set dinlenme (sn)<input id="rest23" type="number" min="0" step="5"></label>
              <label>3→4 set dinlenme (sn)<input id="rest34" type="number" min="0" step="5"></label>
              <label>4→5 set dinlenme (sn)<input id="rest45" type="number" min="0" step="5"></label>
            </div>
            <div id="movementEffectPreview" class="movement-effect-preview"></div>
            <div id="loadPrescriptionBox" class="load-prescription-box"></div>
            <div id="unifiedPhysiologyPreview" class="unified-physiology-preview"></div>
            <div id="restRecommendationBox" class="rest-recommendation-box"></div>
            <div class="rest-timer">
              <div>
                <span>SET ARASI TIMER</span>
                <strong id="restTimerDisplay">02:00</strong>
                <small id="restTimerStatus">Önerilen dinlenme süresini kullanır.</small>
              </div>
              <div class="rest-timer-actions">
                <button id="restTimerStart" type="button" class="secondary">Başlat</button>
                <button id="restTimerPlus30" type="button" class="secondary">+30 sn</button>
                <button id="restTimerReset" type="button" class="secondary">Sıfırla</button>
              </div>
            </div>
            <p class="hint">Statik hareketlerde set hücreleri saniyedir; ağırlıklı hareketlerde tekrar sayısıdır. Dinlenme sürelerini boş bırakırsan yalnızca planlanan süre saklanır.</p>
          </div>
          <div class="card">
            <div class="section-head"><div><h3>Bugünkü Antrenman</h3><p>Toplam hacim ve performans özeti.</p></div></div>
            <div id="exerciseLog"></div>
            <div id="restEvidenceNote" class="insight-box neutral" style="margin-top:12px"></div>
          </div>
        </div>

        <div class="grid two movement-session-grid">
          <div class="card">
            <div class="section-head">
              <div><h3>Seans Kas Etkisi</h3><p class="hint">Dinamik setler ve statik hold sürelerinden hesaplanan stimulus-equivalent dağılım.</p></div>
              <span id="sessionStimulusBadge" class="plan-badge">0 unit</span>
            </div>
            <div id="sessionMuscleImpact" class="session-muscle-impact"></div>
          </div>
          <div class="card">
            <div class="section-head">
              <div><h3>Antrenman Etki İmzası</h3><p class="hint">Hareketlerin kuvvet, hipertrofi, power, skill, stabilizasyon ve core karakteri.</p></div>
              <span id="sessionMovementConfidence" class="plan-badge">Güven --</span>
            </div>
            <div id="sessionEffectSignature" class="session-effect-signature"></div>
            <div id="sessionStaticSummary" class="insight-box neutral" style="margin-top:10px"></div>
          </div>
        </div>
        <div id="movementScienceNote" class="card movement-science-note"></div>
      </section>

      <section id="nutrition" class="page">
        <div class="grid two">
          <div class="card">
            <div class="section-head"><div><h3>Besin Ekle <small id="nutritionLibraryBadge" class="version-chip">Kütüphane</small></h3><p>Değerleri kütüphane hesaplar ve her kayıt kendi besin snapshot'ını saklar.</p></div><div class="save-wrap"><span id="nutritionSaveStatus" class="save-status"></span><button id="addFoodBtn" class="primary">Öğüne Ekle</button></div></div>
            <div class="form-grid">
              <label>Öğün
                <select id="mealType">
                  <option>Kahvaltı</option><option>Öğle</option><option>Akşam</option>
                  <option>Antrenman Öncesi</option><option>Antrenman Sonrası</option><option>Atıştırmalık</option><option>İş Molası</option>
                </select>
              </label>
              <label>Besin ara <input id="foodSearch" type="search" placeholder="örn. tavuk, yoğurt, muz"></label>
              <label>Kategori <select id="foodCategory"></select></label>
              <label>Besin <select id="foodSelect"></select></label>
              <label>Porsiyon <input id="servings" type="number" step="0.25" min="0.25" value="1"></label>
              <label>Saat <input id="foodTime" type="time"></label>
            </div>
            <div id="foodPreview" class="food-preview-card"></div>
            <p class="hint nutrient-reference-note">Değerler standart porsiyon için referans kompozisyondur; marka, tarif ve pişirme yöntemiyle değişebilir.</p>
          </div>
          <div class="card">
            <div class="section-head"><div><h3>Günlük Beslenme</h3><p>Kalori ve makrolar otomatik.</p></div></div>
            <div class="grid four compact">
              <div class="mini"><span>Kalori</span><strong id="caloriesTotal">0</strong></div>
              <div class="mini"><span>Protein</span><strong id="proteinTotal">0 g</strong></div>
              <div class="mini"><span>Karbonhidrat</span><strong id="carbsTotal">0 g</strong></div>
              <div class="mini"><span>Yağ</span><strong id="fatTotal">0 g</strong></div>
            </div>
            <div class="grid four compact nutrition-secondary-macros">
              <div class="mini"><span>Lif</span><strong id="fiberTotal">0 g</strong></div>
              <div class="mini"><span>Su</span><strong id="waterTotal">0 L</strong></div>
              <div class="mini"><span>Kafein</span><strong id="caffeineTotal">0 mg</strong></div>
              <div class="mini"><span>Gıda sayısı</span><strong id="foodCountTotal">0</strong></div>
            </div>
            <div class="quick-row">
              <button class="secondary water-btn" data-ml="250">+250 ml su</button>
              <button class="secondary water-btn" data-ml="500">+500 ml su</button>
              <button class="secondary water-btn" data-ml="750">+750 ml su</button>
            </div>
            <div id="waterLedgerList" class="water-ledger-list"></div>
            <div id="foodLog"></div>
            <div class="micro-panel">
              <div class="section-head"><div><h3>Mikro Besin Özeti</h3><p class="hint">Günlük kayıtların toplamı; yetişkin referans değerlerle karşılaştırılır.</p></div></div>
              <div id="micronutrientGrid" class="micro-grid"></div>
            </div>
            <div style="margin-top:16px">
              <h3>Beslenme Önerisi</h3>
              <div id="nutritionAdvice" class="insight-box"></div>
            </div>
          </div>
        </div>

        <div class="card nutrition-impact-hero" style="margin-top:16px">
          <div class="section-head">
            <div>
              <h3>Nutrition Impact Engine <small class="version-chip">Evidence-informed v1</small></h3>
              <p class="hint">Yalnızca ne yediğini değil; beslenmenin kilo yönü, hipertrofi ortamı, kas koruma, performans yakıtı, hidrasyon ve recovery üzerindeki olası etkisini izler.</p>
            </div>
            <span id="nutritionImpactConfidence" class="plan-badge">Güven --</span>
          </div>

          <div class="nutrition-state-strip">
            <div class="nutrition-state-main">
              <span>OBSERVED NUTRITION STATE</span>
              <strong id="nutritionObservedState">Veri bekleniyor</strong>
              <p id="nutritionObservedStateText">Yeterli uzun dönem veri oluşunca enerji yönü sınıflandırılacak.</p>
            </div>
            <div class="nutrition-impact-stat"><span>Kilo Trendi</span><strong id="nutritionWeightTrend">--</strong><small>kg / hafta</small></div>
            <div class="nutrition-impact-stat"><span>Bel Trendi</span><strong id="nutritionWaistTrend">--</strong><small>cm / 4 hafta</small></div>
            <div class="nutrition-impact-stat"><span>14G Kalori</span><strong id="nutritionAvgCalories">--</strong><small>günlük ort.</small></div>
          </div>

          <div id="nutritionImpactMatrix" class="nutrition-impact-matrix"></div>
          <div id="nutritionPrimaryLimiter" class="insight-box neutral" style="margin-top:12px"></div>
        </div>

        <div class="grid two nutrition-impact-details" style="margin-top:16px">
          <div class="card">
            <div class="section-head"><div><h3>Vücutta Muhtemel Etkiler</h3><p class="hint">Kesin teşhis değil; kayıtların üzerinden olasılık ve risk sinyali.</p></div></div>
            <div id="nutritionImpactEffects" class="recommendation-stack"></div>
          </div>
          <div class="card">
            <div class="section-head"><div><h3>Nutrition → Adaptation Map</h3><p class="hint">Hangi beslenme faktörünün hangi performans çıktısını etkilediğini gösterir.</p></div></div>
            <div id="nutritionCausalMap" class="nutrition-causal-map"></div>
          </div>
        </div>

        <div class="grid two" style="margin-top:16px">
          <div class="card">
            <div class="section-head"><div><h3>Cut / Bulk Kalitesi</h3><p class="hint">Sadece kilo değişimine değil, bel ve performans trendine de bakar.</p></div></div>
            <div id="nutritionPhaseQuality" class="phase-quality"></div>
          </div>
          <div class="card">
            <div class="section-head"><div><h3>Bilimsel Kanıt Katmanı</h3><p class="hint">Skorların dayandığı ana prensipler ve motorun bilmediği şeyler.</p></div></div>
            <div id="nutritionEvidencePanel" class="evidence-stack"></div>
          </div>
        </div>
      </section>

      <section id="analytics" class="page">
        <div class="grid four">
          <div class="card metric"><span>Plan Uyumu</span><strong id="adherenceScore">--</strong><small>Haftalık</small></div>
          <div class="card metric"><span>Adaptasyon</span><strong id="adaptationScore">--</strong><small>Sürprizlere rağmen</small></div>
          <div class="card metric"><span>Uyku Borcu</span><strong id="sleepDebt">--</strong><small>7 günlük</small></div>
          <div class="card metric"><span>Nutrition</span><strong id="nutritionScore">--</strong><small>7 günlük</small></div>
        </div>

        <div class="card architecture-card">
          <div class="section-head"><div><h3>Athlete OS Architecture <small class="version-chip">v9.0</small></h3><p class="hint">Event Store · Engine Bus · Lineage · Calibration · Solver · Tissue Load · Adaptive Nutrition</p></div><span id="architectureHealthBadge" class="plan-badge">CORE</span></div>
          <div id="architectureCoreGrid" class="universal-mesh-metrics"></div>
          <div id="architectureDecisionPreview" class="insight-box neutral" style="margin-top:10px"></div>
        </div>

        <div class="card periodic-trend-card">
          <div class="section-head">
            <div>
              <h3>Periyodik Gelişim Analizi <small class="version-chip">v7.15</small></h3>
              <p class="hint">Aynı hareketin önceki dönem performansıyla karşılaştırır: yükseliş / plato / düşüş / stabil.</p>
            </div>
            <span id="periodicTrendBadge" class="plan-badge">--</span>
          </div>
          <div class="periodic-trend-tabs">
            <button class="periodic-trend-tab" data-period="weekly">Haftalık</button>
            <button class="periodic-trend-tab active" data-period="monthly">Aylık</button>
            <button class="periodic-trend-tab" data-period="cycle">12 Hafta</button>
          </div>
          <div id="periodicTrendSummary" class="insight-box neutral"></div>
          <div id="periodicTrendMovements" class="periodic-trend-movements"></div>
        </div>

        <div class="card universal-mesh-card">
          <div class="section-head">
            <div><h3>Universal Training Mesh <small class="version-chip">v7.14</small></h3><p class="hint">Planlı + Guided + manuel + substitution + plan dışı bütün gerçek training load aynı 7 günlük ağda.</p></div>
            <span id="universalMeshBadge" class="plan-badge">--</span>
          </div>
          <div id="universalMeshMetrics" class="universal-mesh-metrics"></div>
          <div id="universalMeshSources" class="summary-list"></div>
        </div>

        <div class="card guided-history-card">
          <div class="section-head">
            <div><h3>Set Timing Consistency</h3><p class="hint">Guided Workout ile kaydedilen setlerin 28 günlük zamanlama kalite trendi.</p></div>
            <span id="guided28dScore" class="plan-badge">--</span>
          </div>
          <div class="guided-chart-wrap history"><canvas id="guidedHistoryChart"></canvas></div>
          <div id="guidedHistorySummary" class="summary-list"></div>
        </div>

        <div class="card adherence-trend-card">
          <div class="section-head">
            <div>
              <h3>Programa Sadakat Trendi</h3>
              <p class="hint">Mavi: plan uyumu · Yeşil: adaptasyon başarısı. Akıllı sapmalar ikincisinde korunabilir.</p>
            </div>
            <div class="adherence-range">
              <button type="button" class="adherence-range-btn" data-days="7">7G</button>
              <button type="button" class="adherence-range-btn active" data-days="14">14G</button>
              <button type="button" class="adherence-range-btn" data-days="30">30G</button>
            </div>
          </div>
          <div class="grid four compact">
            <div class="mini"><span>7G Plan Uyumu</span><strong id="adh7Score">--</strong></div>
            <div class="mini"><span>30G Plan Uyumu</span><strong id="adh30Score">--</strong></div>
            <div class="mini"><span>Adaptasyon Başarısı</span><strong id="adapt30Score">--</strong></div>
            <div class="mini"><span>Akıllı Sapma</span><strong id="smartDeviationCount">--</strong></div>
          </div>
          <div class="adherence-chart-wrap">
            <canvas id="adherenceChart" aria-label="Program uyumu ve adaptasyon trend grafiği"></canvas>
          </div>
          <div id="adherenceLegend" class="adherence-legend"></div>
          <div id="adherenceBreakdown" class="adherence-breakdown"></div>
        </div>

        <div class="grid two">
          <div class="card">
            <h3>Haftalık Özet</h3>
            <div id="weeklySummary" class="summary-list"></div>
          </div>
          <div class="card">
            <h3>Kişisel İçgörü</h3>
            <div id="personalInsight" class="insight-box">Yeterli veri oluştuğunda burada kişisel örüntüler gösterilecek.</div>
          </div>
        </div>
      </section>


      <section id="detailed" class="page">
        <div class="analysis-layout">
          <div class="analysis-menu card">
            <h3>Detaylı Analiz</h3>
