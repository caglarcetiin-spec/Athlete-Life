ALOS_V2_ENABLED=1
ALOS_V2_ENVIRONMENT=development
ALOS_V2_DATABASE_URL=mongodb://127.0.0.1:27028/?replicaSet=alos-test
ALOS_V2_MONGO_DATABASE=alos_test_dev
ALOS_V2_PUBLIC_ORIGIN=http://127.0.0.1:10005
ALOS_V2_REGISTRATION_ENABLED=0
PORT=10005
# This file is documentation. The app never implicitly reads .env.
# Optional AI planner. Set secrets in the SERVER environment, never VITE_* or source.
# Empty settings keep AI generation visibly disabled. No paid request on startup.
ALOS_V2_OPENAI_API_KEY=
ALOS_V2_OPENAI_MODEL=
# Per 15-minute window; not a currency spending cap.
ALOS_V2_AI_USER_LIMIT=3
ALOS_V2_AI_GLOBAL_LIMIT=20
# Choose exactly one provider; there is no automatic provider fallback.
ALOS_V2_AI_PROVIDER=evren
ALOS_V2_EVREN_API_KEY=
ALOS_V2_EVREN_MODEL=qwen3.8-flash-next
# Optional: only set a value explicitly supported by the selected EVREN model.
# Selected by the synthetic Athlete Life comparison: Qwen3.8-Flash-Next.
ALOS_V2_EVREN_REASONING_EFFORT=low
