  "methods": [
    {
      "id": "continuous",
      "name": "Kesintisiz çalışma",
      "description": "Belirli bir süre veya mesafe boyunca kesintisiz çalışma. Süre, mesafe ve hissedilen zorlukla izlenir."
    },
    {
      "id": "interval",
      "name": "Aralıklı çalışma",
      "description": "Çalışma bölümleri ile dinlenme bölümlerini sırayla uygular. Dönem planında çalışma ve dinlenme adımları, seans kaydında gerçekleşen turlar tutulur."
    },
    {
      "id": "fartlek",
      "name": "Fartlek",
      "description": "Seans içinde tempo değişimlerine yer verir. Hız değişimlerini ve parkur koşullarını not et."
    },
    {
      "id": "technique",
      "name": "Teknik çalışma",
      "description": "Branşa özgü bir hareketin uygulanışına odaklanır. Tekrarın yanında teknik gözlemini kaydet."
    },
    {
      "id": "strength-sets",
      "name": "Kuvvet setleri",
      "description": "Hareket, dış yük, set, tekrar, RIR ve dinlenme ile tanımlanır. Set hedeflerini dönem adımlarına ekleyebilir, gerçekleşenleri bağlı seansta kaydedebilirsin."
    },
    {
      "id": "hypertrophy",
      "name": "Hipertrofi odaklı çalışma",
      "description": "Kas gelişimi hedefli direnç çalışması. Ayrıntılı hareket ve set kayıtları mevcut Antrenman ekranında tutulur."
    },
    {
      "id": "circuit",
      "name": "İstasyon çalışması",
      "description": "Birden fazla hareket veya istasyon sırayla uygulanır. İstasyonları ve tur düzenini seans notuna ekle."
    },
    {
